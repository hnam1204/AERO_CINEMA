@{
    ViewBag.Title = "Lịch Chiếu Phim - AERO Cinema";
}

<style>
    /* Showtimes Page Styling */
    .showtimes-header {
        margin: 40px 0 30px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-left: 5px solid var(--primary-color, #005baa);
        padding-left: 15px;
    }

    .showtimes-header h1 {
        font-family: 'Raleway', sans-serif;
        font-size: 32px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
        color: var(--text-main, #333333);
    }

    /* PREMIUM FILTER BAR */
    .filter-bar {
        background-color: var(--bg-card, #ffffff);
        padding: 25px;
        border-radius: 12px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin-bottom: 40px;
        border: 1px solid var(--border-color, #e0e0e0);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .filter-group label {
        font-family: 'Raleway', sans-serif;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-sub, #777777);
        letter-spacing: 0.5px;
    }

    .select-wrapper {
        position: relative;
        width: 100%;
    }

    .filter-group select {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid var(--border-color, #e0e0e0);
        color: var(--text-main, #333333);
        padding: 14px 20px;
        font-family: 'Raleway', sans-serif;
        font-size: 14px;
        font-weight: 500;
        border-radius: 8px;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .filter-group select:focus {
        border-color: var(--primary-color, #005baa);
        box-shadow: 0 0 0 3px rgba(0, 91, 170, 0.1);
    }

    .select-wrapper::after {
        content: '\f107';
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-sub, #777777);
        pointer-events: none;
        transition: color 0.3s;
    }

    .select-wrapper:hover::after {
        color: var(--text-main, #333333);
    }

    /* SHOWTIMES LISTING */
    .showtimes-container {
        display: flex;
        flex-direction: column;
        gap: 30px;
        margin-bottom: 60px;
    }

    .movie-showtime-card {
        background-color: var(--bg-card, #ffffff);
        border-radius: 12px;
        border: 1px solid var(--border-color, #e0e0e0);
        padding: 30px;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 35px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .movie-showtime-card:hover {
        transform: translateY(-4px);
        border-color: rgba(0, 91, 170, 0.2);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .movie-poster-box {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .movie-poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .movie-showtime-card:hover .movie-poster-box img {
        transform: scale(1.05);
    }

    .movie-rating-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        color: #fff;
        font-weight: 800;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        z-index: 10;
    }

    .movie-rating-badge.badge-t18 { background-color: #e74c3c; }
    .movie-rating-badge.badge-t16 { background-color: #e67e22; }
    .movie-rating-badge.badge-t13 { background-color: #3498db; }
    .movie-rating-badge.badge-p { background-color: #2ecc71; }

    .movie-info-details {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .movie-title-row h3 {
        font-family: 'Raleway', sans-serif;
        font-size: 24px;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        color: var(--text-main, #333333);
        letter-spacing: 0.5px;
    }

    .movie-meta-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        font-size: 13px;
        color: var(--text-sub, #777777);
    }

    .movie-meta-tag {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .movie-meta-tag i {
        color: var(--primary-color, #005baa);
    }

    .showtimes-divider {
        height: 1px;
        background: var(--border-color, #e0e0e0);
        width: 100%;
        margin: 5px 0;
    }

    .format-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .format-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-sub, #777777);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .hours-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .hour-btn {
        background-color: var(--bg-body, #f6f6f6);
        border: 1px solid var(--border-color, #e0e0e0);
        color: var(--text-main, #333333);
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .hour-btn:hover {
        background-color: var(--primary-color, #005baa);
        border-color: var(--primary-color, #005baa);
        color: #fff;
        box-shadow: 0 4px 12px rgba(0, 91, 170, 0.2);
        transform: translateY(-2px);
    }

    .loading-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 250px;
        font-size: 16px;
        color: var(--text-sub, #777777);
        width: 100%;
        flex-direction: column;
        gap: 15px;
    }

    .showtimes-empty {
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        padding: 60px 20px;
        color: var(--text-sub, #777777);
        background-color: var(--bg-card, #ffffff);
        border-radius: 12px;
        border: 1px solid var(--border-color, #e0e0e0);
        width: 100%;
        margin-bottom: 60px;
    }

    /* Skeleton Loader & Shimmer Animation */
    .skeleton {
        background: linear-gradient(90deg, #eeeeee 25%, #f8f8f8 50%, #eeeeee 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite;
        border-radius: 8px;
    }

    @@keyframes shimmer {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .filter-bar {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .movie-showtime-card {
            grid-template-columns: 160px 1fr;
            gap: 25px;
            padding: 20px;
        }

        .movie-title-row h3 {
            font-size: 20px;
        }
    }

    @@media (max-width: 768px) {
        .movie-showtime-card {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .movie-poster-box {
            max-width: 180px;
            margin: 0 auto;
        }

        .movie-title-row {
            text-align: center;
        }

        .movie-meta-tags {
            justify-content: center;
        }

        .format-title {
            text-align: center;
        }

        .hours-grid {
            justify-content: center;
        }
    }
</style>

<div class="container">
    
    <!-- HEADER -->
    <div class="showtimes-header">
        <h1 data-i18n="movie_showtimes">Lịch Chiếu Phim</h1>
    </div>
    
    <!-- FILTER BAR -->
    <div class="filter-bar">
        <div class="filter-group">
            <label for="filterCinema" data-i18n="choose_cinema">Chọn Rạp</label>
            <div class="select-wrapper">
                <select id="filterCinema" onchange="applyFilters()">
                    <!-- Populated dynamically -->
                </select>
            </div>
        </div>
        
        <div class="filter-group">
            <label for="filterDate" data-i18n="choose_date">Chọn Ngày</label>
            <div class="select-wrapper">
                <select id="filterDate" onchange="applyFilters()">
                    <!-- Populated dynamically -->
                </select>
            </div>
        </div>
        
        <div class="filter-group">
            <label for="filterMovie" data-i18n="choose_movie">Chọn Phim</label>
            <div class="select-wrapper">
                <select id="filterMovie" onchange="applyFilters()">
                    <!-- Populated dynamically -->
                </select>
            </div>
        </div>
    </div>

    <!-- SHOWTIMES UI STATES -->
    <div id="showtimesSkeleton" class="showtimes-container showtime-skeleton" style="display:none;">
        <div class="movie-showtime-card skeleton-card">
            <div class="movie-poster-box skeleton" style="border-radius: 8px; background-color: #ddd;"></div>
            <div class="movie-info-details" style="width: 100%;">
                <div class="movie-title-row">
                    <div class="skeleton" style="width: 50%; height: 24px; margin-bottom: 8px;"></div>
                    <div class="movie-meta-tags">
                        <div class="skeleton" style="width: 100px; height: 18px;"></div>
                        <div class="skeleton" style="width: 80px; height: 18px;"></div>
                    </div>
                </div>
                <div class="showtimes-divider"></div>
                <div class="format-group">
                    <div class="skeleton" style="width: 120px; height: 14px; margin-bottom: 8px;"></div>
                    <div class="hours-grid">
                        <div class="skeleton" style="width: 80px; height: 42px; border-radius: 6px;"></div>
                        <div class="skeleton" style="width: 80px; height: 42px; border-radius: 6px;"></div>
                        <div class="skeleton" style="width: 80px; height: 42px; border-radius: 6px;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="movie-showtime-card skeleton-card">
            <div class="movie-poster-box skeleton" style="border-radius: 8px; background-color: #ddd;"></div>
            <div class="movie-info-details" style="width: 100%;">
                <div class="movie-title-row">
                    <div class="skeleton" style="width: 40%; height: 24px; margin-bottom: 8px;"></div>
                    <div class="movie-meta-tags">
                        <div class="skeleton" style="width: 90px; height: 18px;"></div>
                        <div class="skeleton" style="width: 70px; height: 18px;"></div>
                    </div>
                </div>
                <div class="showtimes-divider"></div>
                <div class="format-group">
                    <div class="skeleton" style="width: 100px; height: 14px; margin-bottom: 8px;"></div>
                    <div class="hours-grid">
                        <div class="skeleton" style="width: 80px; height: 42px; border-radius: 6px;"></div>
                        <div class="skeleton" style="width: 80px; height: 42px; border-radius: 6px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="showtimesEmpty" class="showtimes-empty" style="display:none;">
        <i class="far fa-calendar-times fa-3x" style="color: var(--accent-color, #f58020); margin-bottom: 15px; display: block;"></i>
        <h3 id="showtimesEmptyTitle" data-i18n="showtimes_empty_title" style="font-weight: 700; color: var(--text-main); margin-bottom: 8px;">Không có lịch chiếu</h3>
        <p id="showtimesEmptyMessage" data-i18n="showtimes_empty_message" style="margin: 0; font-size: 14px;">Chưa có lịch chiếu cho rạp/ngày đã chọn.</p>
    </div>

    <div id="showtimesContainer" class="showtimes-container"></div>

</div>

@section scripts {
    <script type="module">
        import { collection, getDocs, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
        import { autoUpdateStatuses } from "/Scripts/aero-status-updater.js";

        const db = window.db;

        let allMoviesMap = {};
        let cinemas = [];
        let selectedCinemaId = "";
        let selectedDate = "";
        let selectedMovieId = "all";
        let isLoading = false;
        let currentShowtimeRequestId = 0;

        function getLang() {
            return window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || localStorage.getItem("language") || "vi");
        }

        function tr(key, fallback = "") {
            return window.t ? window.t(key, fallback) : (fallback || key);
        }

        function localizeDynamic(value, type) {
            return window.translateDynamic ? window.translateDynamic(value, type) : value;
        }

        function getLocalized(item, field, fallback = "") {
            if (window.getLocalizedField) return window.getLocalizedField(item, field, fallback);
            return safeText(item?.[field], fallback);
        }

        function safeText(value, fallback = "") {
            if (value === undefined || value === null || value === "undefined" || value === "null") return fallback;
            return String(value).trim();
        }

        function clearShowtimeResults() {
            const container = document.getElementById("showtimesContainer");
            if (container) container.innerHTML = "";
        }

        function hideEmptyState() {
            const emptyBox = document.getElementById("showtimesEmpty");
            if (emptyBox) emptyBox.style.display = "none";
        }

        function showSkeleton() {
            const skeleton = document.getElementById("showtimesSkeleton");
            if (skeleton) skeleton.style.display = "flex";
        }

        function hideSkeleton() {
            const skeleton = document.getElementById("showtimesSkeleton");
            if (skeleton) skeleton.style.display = "none";

            document.querySelectorAll("#showtimesContainer .showtime-skeleton, #showtimesContainer .movie-skeleton, #showtimesContainer .skeleton-card")
                .forEach(el => el.remove());
        }

        function showLoadingState() {
            isLoading = true;
            hideEmptyState();
            clearShowtimeResults();
            showSkeleton();
        }

        function showEmptyState(message = tr("showtimes_empty_message")) {
            isLoading = false;
            hideSkeleton();
            clearShowtimeResults();

            const emptyBox = document.getElementById("showtimesEmpty");
            const emptyTitle = document.getElementById("showtimesEmptyTitle");
            const emptyMessage = document.getElementById("showtimesEmptyMessage");
            if (emptyTitle) emptyTitle.textContent = tr("showtimes_empty_title");
            if (emptyMessage) emptyMessage.textContent = message;
            if (emptyBox) emptyBox.style.display = "flex";
        }

        function showResultsState() {
            isLoading = false;
            hideSkeleton();
            hideEmptyState();
        }

        async function withTimeout(promise, ms = 12000) {
            return Promise.race([
                promise,
                new Promise((_, reject) =>
                    setTimeout(() => reject(new Error("Firestore timeout")), ms)
                )
            ]);
        }

        // Generate 7-day selector
        function initDateFilter() {
            const daysOfWeek = getLang() === "en"
                ? ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
                : ["Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy"];
            const today = new Date();
            const filterDate = document.getElementById("filterDate");
            filterDate.innerHTML = "";

            for (let i = 0; i < 7; i++) {
                const d = new Date();
                d.setDate(today.getDate() + i);
                const dateStr = d.toISOString().split('T')[0]; // YYYY-MM-DD
                const dayLabel = i === 0 ? (getLang() === "en" ? "Today" : "Hôm nay") : daysOfWeek[d.getDay()];
                const dayNum = d.getDate();
                const monthNum = d.getMonth() + 1;
                const displayLabel = `${dayLabel} (${dayNum < 10 ? '0' + dayNum : dayNum}/${monthNum < 10 ? '0' + monthNum : monthNum})`;
                
                const option = document.createElement("option");
                option.value = dateStr;
                option.innerText = displayLabel;
                filterDate.appendChild(option);
            }
            selectedDate = filterDate.value;
        }

        function renderCinemaSelect() {
            const filterCinema = document.getElementById("filterCinema");
            filterCinema.innerHTML = `<option value="">${tr("choose_cinema")}</option>`;

            cinemas.forEach(c => {
                const opt = document.createElement("option");
                opt.value = c.id;
                opt.textContent = getLocalized(c, "name", c.name || c.cinemaName || "AERO Cinema");
                filterCinema.appendChild(opt);
            });
        }

        async function loadCinemas() {
            const cacheKey = "aero_cinemas_cache";
            try {
                const snap = await withTimeout(getDocs(collection(db, "cinemas")), 12000);
                cinemas = snap.docs
                    .map(d => ({ id: d.id, ...d.data() }))
                    .filter(c => c.isActive !== false)
                    .filter(c => !["inactive", "disabled", "deleted"].includes(String(c.status || "").toLowerCase()))
                    .sort((a,b) => safeText(a.name).localeCompare(safeText(b.name), "vi"));
                
                localStorage.setItem(cacheKey, JSON.stringify({
                    savedAt: Date.now(),
                    data: cinemas
                }));
            } catch (err) {
                console.error("Load cinemas failed:", err);
                const cached = localStorage.getItem(cacheKey);
                if (cached) {
                    try {
                        cinemas = JSON.parse(cached).data;
                        console.warn("Using cached cinema data because the network is slow.");
                    } catch(e) {
                        cinemas = [];
                    }
                } else {
                    showEmptyState(tr("cinema_error"));
                }
            }
        }

        // Fetch movies from Firestore to populate filters and cache metadata
        async function loadMovies() {
            try {
                const snap = await withTimeout(getDocs(collection(db, "movies")), 12000);
                const movies = snap.docs.map(d => ({ id: d.id, ...d.data() }));

                const filterMovie = document.getElementById("filterMovie");
                filterMovie.innerHTML = `<option value="all">${tr("movies_all")}</option>`;
                
                allMoviesMap = {};
                movies.forEach((data) => {
                    allMoviesMap[data.id] = data;
                    
                    if (data.status === "now_showing") {
                        const option = document.createElement("option");
                        option.value = data.id;
                        option.innerText = getLocalized(data, "title", data.title || "AERO Cinema");
                        filterMovie.appendChild(option);
                    }
                });
            } catch (e) {
                console.error("Error loading movies: ", e);
            }
        }

        function getFilteredShowtimes(docs) {
            return docs
                .map(d => ({ id: d.id, ...d.data() }))
                .filter(st => st.cinemaId === selectedCinemaId)
                .filter(st => st.date === selectedDate)
                .filter(st => selectedMovieId === "all" || st.movieId === selectedMovieId)
                .filter(st => ["active", "upcoming", "showing"].includes(String(st.status || "").toLowerCase()));
        }

        function renderShowtimes(showtimesList) {
            const container = document.getElementById("showtimesContainer");
            if (!container) return;

            const grouped = {};
            showtimesList.forEach((st) => {
                const movieId = safeText(st.movieId, "unknown");
                if (!grouped[movieId]) {
                    grouped[movieId] = {
                        movieTitle: safeText(st.movieTitle, "AERO Cinema"),
                        slots: []
                    };
                }
                grouped[movieId].slots.push(st);
            });

            for (const movieId in grouped) {
                grouped[movieId].slots.sort((a, b) => safeText(a.time).localeCompare(safeText(b.time)));
            }

            let html = "";
            for (const movieId in grouped) {
                const mMeta = allMoviesMap[movieId] || {
                    posterUrl: "https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=300&q=90",
                    genre: "N/A",
                    duration: 120,
                    rating: "P",
                    language: "2D"
                };

                const rating = safeText(mMeta.rating, "P");
                const ratingClass = "badge-" + rating.toLowerCase().replace(/[^a-z0-9]/g, "");
                const movieTitle = getLocalized(mMeta, "title", safeText(grouped[movieId].movieTitle, "AERO Cinema"));
                const posterUrl = safeText(mMeta.posterUrl, "https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=300&q=90");
                const genre = localizeDynamic(safeText(mMeta.genre, "N/A"), "genre");
                const duration = safeText(mMeta.duration, "120");
                const language = localizeDynamic(safeText(mMeta.language, "2D"), "language");

                const slotsHtml = grouped[movieId].slots.map((st) => `
                    <a href="/Booking/Seats?showtimeId=${st.id}" class="hour-btn">${safeText(st.time, "--:--")}</a>
                `).join("");

                html += `
                    <div class="movie-showtime-card">
                        <div class="movie-poster-box">
                            <span class="movie-rating-badge ${ratingClass}">${rating}</span>
                            <img src="${posterUrl}" alt="${movieTitle}" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=300&q=90'" />
                        </div>
                        <div class="movie-info-details">
                            <div class="movie-title-row">
                                <h3>${movieTitle}</h3>
                                <div class="movie-meta-tags">
                                    <div class="movie-meta-tag">
                                        <i class="fas fa-tags"></i>
                                        <span>${genre}</span>
                                    </div>
                                    <div class="movie-meta-tag">
                                        <i class="far fa-clock"></i>
                                        <span>${duration} ${tr("minutes")}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="showtimes-divider"></div>

                            <div class="format-group">
                                <div class="format-title">${language}</div>
                                <div class="hours-grid">
                                    ${slotsHtml}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        // Load showtimes and render grouped by movie
        async function loadShowtimes() {
            const requestId = ++currentShowtimeRequestId;

            if (!selectedCinemaId) {
                showEmptyState(tr("showtimes_select_cinema_msg"));
                return;
            }

            showLoadingState();

            try {
                const snap = await withTimeout(getDocs(collection(db, "showtimes")), 12000);
                if (requestId !== currentShowtimeRequestId) return;

                const showtimesList = getFilteredShowtimes(snap.docs);

                if (!showtimesList.length) {
                    showEmptyState(tr("showtimes_empty_message"));
                    return;
                }

                showResultsState();
                renderShowtimes(showtimesList);

            } catch (e) {
                if (requestId !== currentShowtimeRequestId) return;
                console.error("Error loading showtimes: ", e);
                showEmptyState(tr("showtimes_error"));
            } finally {
                if (requestId === currentShowtimeRequestId) {
                    hideSkeleton();
                    isLoading = false;
                }
            }
        }

        // Apply filters handler
        window.applyFilters = function() {
            selectedCinemaId = document.getElementById("filterCinema").value;
            selectedDate = document.getElementById("filterDate").value;
            selectedMovieId = document.getElementById("filterMovie").value;
            if (selectedCinemaId) {
                loadShowtimes();
            } else {
                ++currentShowtimeRequestId;
                showEmptyState(tr("showtimes_select_cinema_msg"));
            }
        };

        async function initShowtimesPage() {
            try {
                await autoUpdateStatuses(db);
            } catch (e) { console.error(e); }

            // 1. init date
            initDateFilter();

            // 2. load cinemas
            await loadCinemas();

            // 3. get cinemaId from URL
            const params = new URLSearchParams(window.location.search);
            const urlCinemaId = params.get("cinemaId");

            if (urlCinemaId) {
                // If the cinema isn't in the active list, try to fetch it as a fallback
                if (!cinemas.some(c => c.id === urlCinemaId)) {
                    try {
                        const fallbackDoc = await getDoc(doc(db, "cinemas", urlCinemaId));
                        if (fallbackDoc.exists()) {
                            const c = { id: fallbackDoc.id, ...fallbackDoc.data() };
                            if (c.isActive !== false) {
                                cinemas.push(c);
                            }
                        }
                    } catch(e) { console.error("Fallback load cinema failed", e); }
                }
            }

            // 4. render cinema select
            renderCinemaSelect();

            // 5. set selected cinema
            const filterCinema = document.getElementById("filterCinema");
            if (urlCinemaId && cinemas.some(c => c.id === urlCinemaId)) {
                selectedCinemaId = urlCinemaId;
                filterCinema.value = urlCinemaId;
            } else if (cinemas.length > 0) {
                selectedCinemaId = filterCinema.value; 
            }

            // 6. load movies
            await loadMovies();

            // 7. load showtimes
            if (selectedCinemaId) {
                await loadShowtimes();
            } else {
                ++currentShowtimeRequestId;
                showEmptyState(tr("showtimes_select_cinema_msg"));
            }
        }

        // DOM Loaded Init
        window.addEventListener('DOMContentLoaded', () => {
            initShowtimesPage();
        });

        window.addEventListener("aero:languageChanged", async () => {
            if (window.applyLanguage) window.applyLanguage();
            initDateFilter();
            renderCinemaSelect();
            const filterCinema = document.getElementById("filterCinema");
            if (filterCinema && selectedCinemaId) filterCinema.value = selectedCinemaId;
            await loadMovies();
            if (selectedCinemaId) {
                await loadShowtimes();
            } else {
                showEmptyState(tr("showtimes_select_cinema_msg"));
            }
        });
    </script>
}
