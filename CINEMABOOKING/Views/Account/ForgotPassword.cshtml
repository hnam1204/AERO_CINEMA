@{
    ViewBag.Title = "Quên Mật Khẩu - AERO Cinema";
}

<link href="@Url.Content("~/Content/auth.css?v=2")" rel="stylesheet" />

<main class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-overlay"></div>

    <div class="auth-container">
        <div class="auth-card forgot-card">
            <div class="auth-header">
                <div class="auth-logo">AERO<span>Cinema</span></div>
                <h1 class="auth-title" data-translate="forgot_title">QUÊN MẬT KHẨU</h1>
                <div class="auth-subtitle" data-translate="forgot_desc">Nhập email của bạn để nhận mã xác thực OTP khôi phục mật khẩu.</div>
            </div>

            <form id="forgotPasswordForm">
                <div class="reset-step show" id="stepEmail">
                    <div class="form-group">
                        <label for="email" data-translate="login_email_label">Email</label>
                        <div class="form-input-wrap">
                            <input type="email" id="email" class="form-input" data-translate-placeholder="login_email_placeholder" placeholder="Nhập email của bạn" required autocomplete="email" />
                        </div>
                        <span class="field-error" id="emailError" data-translate="error_invalid_email">Email không hợp lệ</span>
                    </div>

                    <button type="button" class="btn-auth-submit" id="sendOtpBtn">
                        <span id="sendOtpText" data-translate="forgot_otp_btn">Gửi mã OTP</span>
                    </button>
                </div>

                <div class="reset-step" id="stepOtp">
                    <p class="hint-text" id="otpHint" data-translate="otp_hint">Mã OTP có hiệu lực trong 5 phút.</p>

                    <div class="form-group">
                        <label for="otpCode" data-translate="reg_otp_label">Mã OTP</label>
                        <div class="form-input-wrap">
                            <input type="text" id="otpCode" class="form-input" data-translate-placeholder="reg_otp_placeholder" placeholder="Nhập 6 số" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                        </div>
                        <span class="field-error" id="otpError" data-translate="error_invalid_otp">Mã OTP không hợp lệ</span>
                    </div>

                    <div class="form-group">
                        <label for="newPassword" data-translate="forgot_new_pass_label">Mật khẩu mới</label>
                        <div class="form-input-wrap">
                            <input type="password" id="newPassword" class="form-input" data-translate-placeholder="forgot_new_pass_placeholder" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                        </div>
                        <span class="field-error" id="passwordError" data-translate="error_weak_password">Mật khẩu chưa đủ mạnh</span>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword" data-translate="reg_confirm_label">Xác nhận mật khẩu mới</label>
                        <div class="form-input-wrap">
                            <input type="password" id="confirmPassword" class="form-input" data-translate-placeholder="reg_confirm_placeholder" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                        </div>
                        <span class="field-error" id="confirmPasswordError" data-translate="error_invalid_confirm">Mật khẩu xác nhận không khớp</span>
                    </div>

                    <button type="submit" class="btn-auth-submit" id="resetBtn">
                        <span id="resetText" data-translate="forgot_submit">Đổi mật khẩu</span>
                    </button>
                </div>
            </form>

            <div class="auth-footer">
                <span data-translate="forgot_has_acc">Nhớ mật khẩu?</span> <a href="@Url.Action("Login", "Account")" data-translate="nav_login">Đăng nhập</a>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module">
        import { sendPasswordResetEmail } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

        const auth = window.auth;
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        const strongPasswordRegex = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[!@@#$%^&*()_\-+=\[\]{};:'"\\|,.<>/?]).{8,}$/;

        const emailInput = document.getElementById("email");
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const sendOtpText = document.getElementById("sendOtpText");
        const resetBtn = document.getElementById("resetBtn");
        const resetText = document.getElementById("resetText");
        const stepEmail = document.getElementById("stepEmail");
        const stepOtp = document.getElementById("stepOtp");
        const otpHint = document.getElementById("otpHint");

        let pendingEmail = "";

        function getLang() {
            return window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || localStorage.getItem("language") || "vi");
        }

        function setError(id, show) {
            document.getElementById(id).classList.toggle("show", show);
        }

        async function postForm(url, payload) {
            const response = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: new URLSearchParams(payload)
            });

            if (!response.ok) {
                throw new Error("Request failed");
            }

            return response.json();
        }

        function showMessage(icon, title, text) {
            return Swal.fire({
                icon,
                title,
                text,
                background: "#ffffff",
                color: "#333333",
                confirmButtonColor: "#f58220"
            });
        }

        sendOtpBtn.addEventListener("click", async () => {
            const isEn = getLang() === "en";
            const email = emailInput.value.trim();
            const invalidEmail = !emailRegex.test(email);
            setError("emailError", invalidEmail);
            if (invalidEmail) return;

            sendOtpBtn.disabled = true;
            sendOtpText.textContent = isEn ? "Sending..." : "Đang gửi...";

            Swal.fire({
                title: isEn ? "Sending code..." : "Đang gửi mã...",
                text: isEn ? "Please wait a moment" : "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            try {
                const currentLang = getLang();
                const result = await postForm("/Otp/SendForgotPasswordOtp", { email, lang: currentLang });

                if (!result.success) {
                    await showMessage("error", isEn ? "Error" : "Lỗi", result.message || (isEn ? "Failed to send verification code." : "Không thể gửi mã xác nhận."));
                    return;
                }

                pendingEmail = email;
                emailInput.readOnly = true;
                stepEmail.classList.remove("show");
                stepOtp.classList.add("show");
                otpHint.textContent = isEn ? "OTP verification code sent to " + email + "." : "Mã OTP đã được gửi đến " + email + ".";
                await showMessage("success", isEn ? "Code Sent" : "Đã gửi mã", isEn ? "Please check your email." : "Vui lòng kiểm tra email.");
            } catch (error) {
                console.error("Send forgot password OTP error:", error);
                await showMessage("error", isEn ? "Error" : "Lỗi", isEn ? "Failed to send verification code." : "Không thể gửi mã xác nhận.");
            } finally {
                sendOtpBtn.disabled = false;
                sendOtpText.textContent = isEn ? "Send OTP" : "Gửi mã";
            }
        });

        document.getElementById("forgotPasswordForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            const isEn = getLang() === "en";
            const otpCode = document.getElementById("otpCode").value.trim();
            const newPassword = document.getElementById("newPassword").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            const otpInvalid = !/^[0-9]{6}$/.test(otpCode);
            const passwordInvalid = !strongPasswordRegex.test(newPassword);
            const confirmInvalid = newPassword !== confirmPassword;

            setError("otpError", otpInvalid);
            setError("passwordError", passwordInvalid);
            setError("confirmPasswordError", confirmInvalid);

            if (otpInvalid || passwordInvalid || confirmInvalid) return;

            resetBtn.disabled = true;
            resetText.textContent = isEn ? "Processing..." : "Đang xử lý...";

            Swal.fire({
                title: isEn ? "Verifying..." : "Đang xác nhận...",
                text: isEn ? "Please wait a moment" : "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            try {
                const currentLang = getLang();
                const verifyResult = await postForm("/Otp/VerifyForgotPasswordOtp", {
                    email: pendingEmail,
                    code: otpCode,
                    lang: currentLang
                });

                if (!verifyResult.success) {
                    await showMessage("error", isEn ? "Error" : "Lỗi", verifyResult.message || (isEn ? "Invalid or expired verification code." : "Mã xác nhận không đúng hoặc đã hết hạn."));
                    return;
                }

                await sendPasswordResetEmail(auth, pendingEmail);

                await Swal.fire({
                    icon: "success",
                    title: isEn ? "Link Sent" : "Đã gửi liên kết",
                    text: isEn ? "Password reset link has been sent to your email." : "Liên kết đổi mật khẩu đã được gửi đến email của bạn.",
                    background: "#ffffff",
                    color: "#333333",
                    confirmButtonColor: "#f58220"
                });

                window.location.href = '@Url.Action("Login", "Account")';
            } catch (error) {
                console.error("Forgot password reset error:", error);

                let message = isEn ? "Failed to send password reset link." : "Không thể gửi liên kết đổi mật khẩu.";
                if (error.code === "auth/user-not-found") {
                    message = isEn ? "Account not found with this email." : "Không tìm thấy tài khoản với email này.";
                } else if (error.code === "auth/invalid-email") {
                    message = isEn ? "Invalid email address." : "Email không hợp lệ.";
                }

                await showMessage("error", isEn ? "Error" : "Lỗi", message);
            } finally {
                resetBtn.disabled = false;
                resetText.textContent = isEn ? "Change Password" : "Đổi mật khẩu";
            }
        });
    </script>
}
