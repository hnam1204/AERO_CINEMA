@{
    ViewBag.Title = "Quên Mật Khẩu - AERO Cinema";
}

<link href="@Url.Content("~/Content/auth.css?v=2")" rel="stylesheet" />

<main class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-overlay"></div>

    <div class="auth-container">
        <div class="auth-card forgot-card">
            <div class="auth-header">
                <div class="auth-logo">AERO<span>Cinema</span></div>
                <h1 class="auth-title">QUÊN MẬT KHẨU</h1>
                <div class="auth-subtitle">Nhập email để nhận mã xác nhận.</div>
            </div>

            <form id="forgotPasswordForm">
                <div class="reset-step show" id="stepEmail">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="form-input-wrap">
                            <input type="email" id="email" class="form-input" placeholder="name@domain.com" required autocomplete="email" />
                        </div>
                        <span class="field-error" id="emailError">Email không hợp lệ</span>
                    </div>

                    <button type="button" class="btn-auth-submit" id="sendOtpBtn">
                        <span id="sendOtpText">Gửi mã</span>
                    </button>
                </div>

                <div class="reset-step" id="stepOtp">
                    <p class="hint-text" id="otpHint">Mã OTP có hiệu lực trong 5 phút.</p>

                    <div class="form-group">
                        <label for="otpCode">Mã OTP</label>
                        <div class="form-input-wrap">
                            <input type="text" id="otpCode" class="form-input" placeholder="Nhập 6 số" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                        </div>
                        <span class="field-error" id="otpError">Mã OTP không hợp lệ</span>
                    </div>

                    <div class="form-group">
                        <label for="newPassword">Mật khẩu mới</label>
                        <div class="form-input-wrap">
                            <input type="password" id="newPassword" class="form-input" placeholder="Ít nhất 8 ký tự" autocomplete="new-password" />
                        </div>
                        <span class="field-error" id="passwordError">Mật khẩu chưa đủ mạnh</span>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <div class="form-input-wrap">
                            <input type="password" id="confirmPassword" class="form-input" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                        </div>
                        <span class="field-error" id="confirmPasswordError">Mật khẩu xác nhận không khớp</span>
                    </div>

                    <button type="submit" class="btn-auth-submit" id="resetBtn">
                        <span id="resetText">Đổi mật khẩu</span>
                    </button>
                </div>
            </form>

            <div class="auth-footer">
                Nhớ mật khẩu? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module">
        import { sendPasswordResetEmail } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

        const auth = window.auth;
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        const strongPasswordRegex = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[!@@#$%^&*()_\-+=\[\]{};:'"\\|,.<>/?]).{8,}$/;

        const emailInput = document.getElementById("email");
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const sendOtpText = document.getElementById("sendOtpText");
        const resetBtn = document.getElementById("resetBtn");
        const resetText = document.getElementById("resetText");
        const stepEmail = document.getElementById("stepEmail");
        const stepOtp = document.getElementById("stepOtp");
        const otpHint = document.getElementById("otpHint");

        let pendingEmail = "";

        function setError(id, show) {
            document.getElementById(id).classList.toggle("show", show);
        }

        async function postForm(url, payload) {
            const response = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: new URLSearchParams(payload)
            });

            if (!response.ok) {
                throw new Error("Request failed");
            }

            return response.json();
        }

        function showMessage(icon, title, text) {
            return Swal.fire({
                icon,
                title,
                text,
                background: "#ffffff",
                color: "#333333",
                confirmButtonColor: "#f58220"
            });
        }

        sendOtpBtn.addEventListener("click", async () => {
            const email = emailInput.value.trim();
            const invalidEmail = !emailRegex.test(email);
            setError("emailError", invalidEmail);
            if (invalidEmail) return;

            sendOtpBtn.disabled = true;
            sendOtpText.textContent = "Đang gửi...";

            Swal.fire({
                title: "Đang gửi mã...",
                text: "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            try {
                const result = await postForm("/Otp/SendForgotPasswordOtp", { email });

                if (!result.success) {
                    await showMessage("error", "Lỗi", result.message || "Không thể gửi mã xác nhận.");
                    return;
                }

                pendingEmail = email;
                emailInput.readOnly = true;
                stepEmail.classList.remove("show");
                stepOtp.classList.add("show");
                otpHint.textContent = "Mã OTP đã được gửi đến " + email + ".";
                await showMessage("success", "Đã gửi mã", "Vui lòng kiểm tra email.");
            } catch (error) {
                console.error("Send forgot password OTP error:", error);
                await showMessage("error", "Lỗi", "Không thể gửi mã xác nhận.");
            } finally {
                sendOtpBtn.disabled = false;
                sendOtpText.textContent = "Gửi mã";
            }
        });

        document.getElementById("forgotPasswordForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            const otpCode = document.getElementById("otpCode").value.trim();
            const newPassword = document.getElementById("newPassword").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            const otpInvalid = !/^[0-9]{6}$/.test(otpCode);
            const passwordInvalid = !strongPasswordRegex.test(newPassword);
            const confirmInvalid = newPassword !== confirmPassword;

            setError("otpError", otpInvalid);
            setError("passwordError", passwordInvalid);
            setError("confirmPasswordError", confirmInvalid);

            if (otpInvalid || passwordInvalid || confirmInvalid) return;

            resetBtn.disabled = true;
            resetText.textContent = "Đang xử lý...";

            Swal.fire({
                title: "Đang xác nhận...",
                text: "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            try {
                const verifyResult = await postForm("/Otp/VerifyForgotPasswordOtp", {
                    email: pendingEmail,
                    code: otpCode
                });

                if (!verifyResult.success) {
                    await showMessage("error", "Lỗi", verifyResult.message || "Mã xác nhận không đúng hoặc đã hết hạn.");
                    return;
                }

                await sendPasswordResetEmail(auth, pendingEmail);

                await Swal.fire({
                    icon: "success",
                    title: "Đã gửi liên kết",
                    text: "Liên kết đổi mật khẩu đã được gửi đến email của bạn.",
                    background: "#ffffff",
                    color: "#333333",
                    confirmButtonColor: "#f58220"
                });

                window.location.href = '@Url.Action("Login", "Account")';
            } catch (error) {
                console.error("Forgot password reset error:", error);

                let message = "Không thể gửi liên kết đổi mật khẩu.";
                if (error.code === "auth/user-not-found") {
                    message = "Không tìm thấy tài khoản với email này.";
                } else if (error.code === "auth/invalid-email") {
                    message = "Email không hợp lệ.";
                }

                await showMessage("error", "Lỗi", message);
            } finally {
                resetBtn.disabled = false;
                resetText.textContent = "Đổi mật khẩu";
            }
        });
    </script>
}
