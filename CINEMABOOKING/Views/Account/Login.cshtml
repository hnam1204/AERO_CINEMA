@{
    ViewBag.Title = "Đăng Nhập - AERO Cinema";
}

<link href="@Url.Content("~/Content/auth.css?v=2")" rel="stylesheet" />

<main class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-overlay"></div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">AERO<span>Cinema</span></div>
                <h1 class="auth-title" data-translate="login_title">ĐĂNG NHẬP</h1>
                <div class="auth-subtitle" data-translate="login_subtitle">Tiếp tục đặt vé và quản lý tài khoản.</div>
            </div>

            <form id="loginForm">
                <div class="form-group">
                    <label for="email" data-translate="login_email_label">Email</label>
                    <div class="form-input-wrap">
                        <input type="email" id="email" class="form-input" data-translate-placeholder="login_email_placeholder" placeholder="Nhập email của bạn" required autocomplete="email" />
                    </div>
                    <span class="field-error" id="emailError" data-translate="error_invalid_email">Email không hợp lệ</span>
                </div>

                <div class="form-group">
                    <label for="password" data-translate="login_pass_label">Mật khẩu</label>
                    <div class="form-input-wrap">
                        <input type="password" id="password" class="form-input" data-translate-placeholder="login_pass_placeholder" placeholder="Nhập mật khẩu" required autocomplete="current-password" />
                    </div>
                    <span class="field-error" id="passwordError" data-translate="error_require_password">Vui lòng nhập mật khẩu</span>
                </div>

                <div class="form-helper">
                    <label>
                        <input type="checkbox" id="remember" /> <span data-translate="login_remember">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="@Url.Action("ForgotPassword", "Account")" data-translate="login_forgot">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
                    <span id="loginSubmitText" data-translate="login_submit">Đăng nhập</span>
                </button>
            </form>

            <div class="auth-footer">
                <span data-translate="login_no_acc">Chưa có tài khoản?</span> <a href="@Url.Action("Register", "Account")" data-translate="login_reg_now">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module">
        import {
            signInWithEmailAndPassword,
            setPersistence,
            browserLocalPersistence,
            browserSessionPersistence,
            signOut,
            onAuthStateChanged
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import {
            doc,
            getDoc,
            collection,
            query,
            where,
            limit,
            getDocs
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const auth = window.auth;
        const db = window.db;
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        const loginSubmitBtn = document.getElementById("loginSubmitBtn");
        const loginSubmitText = document.getElementById("loginSubmitText");

        // === Anti-delay flags ===
        let isLoggingIn = false;
        let hasRedirected = false;

        function setError(id, show) {
            document.getElementById(id).classList.toggle("show", show);
        }

        function getLang() {
            return window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || localStorage.getItem("language") || "vi");
        }

        function isEnglish() {
            return getLang() === "en";
        }

        function showError(title, message) {
            Swal.fire({
                icon: "error",
                title,
                text: message,
                background: "#ffffff",
                color: "#333333",
                confirmButtonColor: "#f58220"
            });
        }

        async function postForm(url, payload) {
            const body = new URLSearchParams(payload);
            const response = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body
            });

            return response.ok ? response.json() : { success: false };
        }

        // === Safe Return URL resolution ===
        function getSafeReturnUrl() {
            const params = new URLSearchParams(window.location.search);
            let url = params.get("returnUrl") || sessionStorage.getItem("aero_return_url");

            if (!url) return null;
            if (!url.startsWith("/") || url.startsWith("//") || url.includes("://")) return null;
            // NOTE: /Admin URLs are allowed here – admin will be redirect-checked by role anyway
            return url;
        }

        // === Detect admin context ===
        function isAdminContext() {
            const params = new URLSearchParams(window.location.search);
            const returnUrl = params.get("returnUrl") || sessionStorage.getItem("aero_return_url") || "";
            return returnUrl.toLowerCase().startsWith("/admin") || params.get("area") === "admin";
        }

        // === Update title/subtitle based on context ===
        (function updateLoginContext() {
            if (!isAdminContext()) return;
            const titleEl = document.querySelector(".auth-title");
            const subtitleEl = document.querySelector(".auth-subtitle");
            const lang = window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || "vi");
            if (titleEl) titleEl.innerText = lang === "en" ? "ADMIN LOGIN" : "ĐĂNG NHẬP QUẢN TRỊ";
            if (subtitleEl) subtitleEl.innerText = lang === "en" ? "Sign in with your admin account to access the control panel." : "Vui lòng đăng nhập tài khoản quản trị để tiếp tục.";
        })();

        function isSafeLocalUrl(url) {
            return typeof url === "string" && url.startsWith("/") && !url.startsWith("//") && !url.includes("://");
        }

        async function findUserDocumentByEmail(email) {
            try {
                const normalizedEmail = String(email || "").trim().toLowerCase();
                const candidates = [normalizedEmail];

                if (email && email !== normalizedEmail) {
                    candidates.push(email);
                }

                for (const candidate of candidates) {
                    const emailQuery = query(
                        collection(db, "users"),
                        where("email", "==", candidate),
                        limit(3)
                    );
                    const snap = await getDocs(emailQuery);
                    if (!snap.empty) {
                        return snap.docs.map(item => ({
                            id: item.id,
                            path: `users/${item.id}`,
                            data: item.data()
                        }));
                    }
                }
            } catch (error) {
                // Silently handle email lookup failure — Firestore Rules may not allow this for non-admin users
            }

            return [];
        }

        async function loadUserDocumentAfterLogin(user) {
            const userDocPath = `users/${user.uid}`;
            const userDocRef = doc(db, "users", user.uid);
            const userSnap = await getDoc(userDocRef);
            const userData = userSnap.exists() ? userSnap.data() : null;
            const emailMatches = userData ? [] : await findUserDocumentByEmail(user.email);

            return {
                exists: userSnap.exists(),
                path: userDocPath,
                data: userData,
                emailMatches
            };
        }

        async function redirectByRole(user, loginEmail) {
            console.log("[Login] loading profile...");
            const result = await loadUserDocumentAfterLogin(user);

            if (!result.exists) {
                console.warn("[Login] profile not found");
                await signOut(auth);
                throw new Error(isEnglish() ? "User profile was not found." : "Không tìm thấy hồ sơ người dùng.");
            }

            console.log("[Login] profile loaded");
            const profile = result.data;
            const role = String(profile.role || "").trim().toLowerCase();
            const status = String(profile.status || "active").trim().toLowerCase();
            const fullName = profile.fullName || "";

            if (status !== "active") {
                console.warn("[Login] user blocked");
                await signOut(auth);
                if (status === "blocked") {
                    throw new Error(isEnglish() ? "This account has been locked." : "Tài khoản đã bị khóa.");
                }
                throw new Error(isEnglish() ? `Account status is "${status}". Only active accounts can log in.` : `Tài khoản đang có status = "${status}". Chỉ tài khoản active mới được đăng nhập.`);
            }

            // Cache auth user
            const authUser = {
                uid: user.uid,
                email: user.email,
                role: role,
                status: status,
                fullName: fullName || user.email,
                cachedAt: Date.now()
            };
            sessionStorage.setItem("aero_auth_user", JSON.stringify(authUser));
            sessionStorage.setItem("aero_user_role", role);
            sessionStorage.setItem("aero_user_status", status);
            sessionStorage.setItem("aero_user_name", fullName);

            if (role === "admin") {
                console.log("[Login] role admin -> redirect Admin");
                sessionStorage.removeItem("aero_return_url");
                return "/Admin/Dashboard";
            }

            console.log("[Login] role user -> redirect User");
            const returnUrl = getSafeReturnUrl();
            if (returnUrl) {
                return returnUrl;
            }

            return "/";
        }

        // === Safe redirect (only once) ===
        function safeRedirect(url) {
            if (hasRedirected) return;
            hasRedirected = true;
            sessionStorage.removeItem("aero_return_url");
            
            if (url.toLowerCase().startsWith("/admin")) {
                window.location.replace(url);
            } else {
                window.location.href = url;
            }
        }

        // === Auto redirect if already authenticated ===
        let loginAuthChecked = false;
        const unsubscribe = onAuthStateChanged(auth, async (user) => {
            if (loginAuthChecked) return;
            loginAuthChecked = true;
            unsubscribe();

            if (!user) return;

            console.log("[Login] start (auto check)");
            try {
                const redirectUrl = await redirectByRole(user, user.email);
                safeRedirect(redirectUrl);
            } catch (error) {
                console.warn("[Login] auto-redirect check failed:", error);
            }
        });

        document.getElementById("loginForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            // Prevent double submit
            if (isLoggingIn) return;

            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value;
            const remember = document.getElementById("remember").checked;
            const emailInvalid = !emailRegex.test(email);
            const passwordInvalid = !password;

            setError("emailError", emailInvalid);
            setError("passwordError", passwordInvalid);

            if (emailInvalid || passwordInvalid) {
                return;
            }

            isLoggingIn = true;
            loginSubmitBtn.disabled = true;
            loginSubmitText.textContent = isEnglish() ? "Logging in..." : "Đang đăng nhập...";
            console.log("[Login] start");

            Swal.fire({
                title: isEnglish() ? "Logging in..." : "Đang đăng nhập...",
                text: isEnglish() ? "Please wait a moment" : "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            // === Timeout 10s fallback ===
            const timeoutId = setTimeout(() => {
                if (!hasRedirected) {
                    isLoggingIn = false;
                    loginSubmitBtn.disabled = false;
                    loginSubmitText.textContent = isEnglish() ? "Login" : "Đăng nhập";
                    Swal.fire({
                        icon: "warning",
                        title: isEnglish() ? "Login is taking longer than usual" : "Đăng nhập chậm",
                        text: isEnglish() ? "The connection is slow. Please try again." : "Kết nối chậm, vui lòng thử lại.",
                        background: "#ffffff",
                        color: "#333333",
                        confirmButtonColor: "#f58220"
                    });
                }
            }, 10000);

            try {
                await setPersistence(auth, remember ? browserLocalPersistence : browserSessionPersistence);
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                console.log("[Login] auth success");
                const redirectUrl = await redirectByRole(userCredential.user, email);

                clearTimeout(timeoutId);

                postForm("/Otp/SendLoginAlert", { email }).catch((error) => {
                    console.warn("Login alert email skipped:", error);
                });

                if (hasRedirected) return;
                hasRedirected = true;

                Swal.fire({
                    icon: "success",
                    title: isEnglish() ? "Login successful" : "Đăng nhập thành công",
                    text: isEnglish() ? "Redirecting..." : "Đang chuyển hướng...",
                    background: "#ffffff",
                    color: "#333333",
                    confirmButtonColor: "#f58220",
                    timer: 900,
                    showConfirmButton: false
                }).then(() => {
                    hasRedirected = false;
                    safeRedirect(redirectUrl);
                });
            } catch (error) {
                clearTimeout(timeoutId);
                console.error("Error signing in:", error);

                let message = error.message || (isEnglish() ? "Email or password is incorrect." : "Email hoặc mật khẩu không chính xác.");
                if (error.code === "auth/invalid-email") {
                    message = isEnglish() ? "Invalid email." : "Email không hợp lệ.";
                } else if (error.code === "auth/user-disabled") {
                    message = isEnglish() ? "This account has been locked." : "Tài khoản này đã bị khóa.";
                } else if (error.code === "auth/user-not-found") {
                    message = isEnglish() ? "Account does not exist." : "Tài khoản không tồn tại.";
                } else if (error.code === "auth/wrong-password") {
                    message = isEnglish() ? "Incorrect password." : "Mật khẩu không chính xác.";
                } else if (error.code === "auth/invalid-credential") {
                    message = isEnglish() ? "Email or password is incorrect." : "Email hoặc mật khẩu không chính xác.";
                }

                showError(isEnglish() ? "Login failed" : "Đăng nhập thất bại", message);
                
                isLoggingIn = false;
                loginSubmitBtn.disabled = false;
                loginSubmitText.textContent = isEnglish() ? "Login" : "Đăng nhập";
            }
        });
    </script>
}
