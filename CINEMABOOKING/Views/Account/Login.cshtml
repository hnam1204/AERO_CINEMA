@{
    ViewBag.Title = "Đăng Nhập - AERO Cinema";
}

<link href="@Url.Content("~/Content/auth.css?v=2")" rel="stylesheet" />

<main class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-overlay"></div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">AERO<span>Cinema</span></div>
                <h1 class="auth-title">ĐĂNG NHẬP</h1>
                <div class="auth-subtitle">Tiếp tục đặt vé và quản lý tài khoản.</div>
            </div>

            <form id="loginForm">
                <div class="form-group">
                    <label for="email">Email</label>
                    <div class="form-input-wrap">
                        <input type="email" id="email" class="form-input" placeholder="name@domain.com" required autocomplete="email" />
                    </div>
                    <span class="field-error" id="emailError">Email không hợp lệ</span>
                </div>

                <div class="form-group">
                    <label for="password">Mật khẩu</label>
                    <div class="form-input-wrap">
                        <input type="password" id="password" class="form-input" placeholder="••••••••" required autocomplete="current-password" />
                    </div>
                    <span class="field-error" id="passwordError">Vui lòng nhập mật khẩu</span>
                </div>

                <div class="form-helper">
                    <label>
                        <input type="checkbox" id="remember" /> Ghi nhớ đăng nhập
                    </label>
                    <a href="@Url.Action("ForgotPassword", "Account")">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-auth-submit" id="loginSubmitBtn">
                    <span id="loginSubmitText">Đăng nhập</span>
                </button>
            </form>

            <div class="auth-footer">
                Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký</a>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="module">
        import {
            signInWithEmailAndPassword,
            setPersistence,
            browserLocalPersistence,
            browserSessionPersistence,
            signOut
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import {
            doc,
            getDoc,
            collection,
            query,
            where,
            limit,
            getDocs
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const auth = window.auth;
        const db = window.db;
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        const loginSubmitBtn = document.getElementById("loginSubmitBtn");
        const loginSubmitText = document.getElementById("loginSubmitText");

        function setError(id, show) {
            document.getElementById(id).classList.toggle("show", show);
        }

        function showError(title, message) {
            Swal.fire({
                icon: "error",
                title,
                text: message,
                background: "#ffffff",
                color: "#333333",
                confirmButtonColor: "#f58220"
            });
        }

        async function postForm(url, payload) {
            const body = new URLSearchParams(payload);
            const response = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body
            });

            return response.ok ? response.json() : { success: false };
        }

        function getReturnUrl() {
            return new URLSearchParams(window.location.search).get("returnUrl") || "";
        }

        function isSafeLocalUrl(url) {
            return typeof url === "string" && url.startsWith("/") && !url.startsWith("//");
        }

        async function findUserDocumentByEmail(email) {
            try {
                const normalizedEmail = String(email || "").trim().toLowerCase();
                const candidates = [normalizedEmail];

                if (email && email !== normalizedEmail) {
                    candidates.push(email);
                }

                for (const candidate of candidates) {
                    const emailQuery = query(
                        collection(db, "users"),
                        where("email", "==", candidate),
                        limit(3)
                    );
                    const snap = await getDocs(emailQuery);
                    if (!snap.empty) {
                        return snap.docs.map(item => ({
                            id: item.id,
                            path: `users/${item.id}`,
                            data: item.data()
                        }));
                    }
                }
            } catch (error) {
                console.warn("AERO ADMIN DEBUG - Query users by email failed. Firestore Rules may not allow this for non-admin users.", error);
            }

            return [];
        }

        async function loadUserDocumentAfterLogin(user) {
            const userDocPath = `users/${user.uid}`;
            const userDocRef = doc(db, "users", user.uid);
            const userSnap = await getDoc(userDocRef);
            const userData = userSnap.exists() ? userSnap.data() : null;
            const emailMatches = userData ? [] : await findUserDocumentByEmail(user.email);

            console.log("AERO ADMIN DEBUG - Auth UID:", user.uid);
            console.log("AERO ADMIN DEBUG - Email:", user.email);
            console.log("AERO ADMIN DEBUG - Document path đang đọc:", userDocPath);
            console.log("AERO ADMIN DEBUG - User data Firestore:", userData);
            console.log("AERO ADMIN DEBUG - Role:", userData?.role);
            console.log("AERO ADMIN DEBUG - Status:", userData?.status);
            if (emailMatches.length > 0) {
                console.warn("AERO ADMIN DEBUG - Tìm thấy document theo email nhưng sai UID:", emailMatches);
            }

            return {
                exists: userSnap.exists(),
                path: userDocPath,
                data: userData,
                emailMatches
            };
        }

        async function redirectByRole(user, loginEmail) {
            const result = await loadUserDocumentAfterLogin(user);

            if (!result.exists) {
                await signOut(auth);

                const wrongDocHint = result.emailMatches.length > 0
                    ? ` Firestore đang có document theo email tại ${result.emailMatches.map(item => item.path).join(", ")} nhưng document ID không trùng Auth UID ${user.uid}. Hãy đổi/tạo lại document users/${user.uid}.`
                    : "";

                throw new Error(`Không tìm thấy hồ sơ Firestore tại ${result.path}.${wrongDocHint}`);
            }

            const role = String(result.data.role || "").trim().toLowerCase();
            const status = String(result.data.status || "active").trim().toLowerCase();

            if (status !== "active") {
                await signOut(auth);
                throw new Error(`Tài khoản đang có status = "${status}". Chỉ tài khoản active mới được đăng nhập.`);
            }

            if (role === "admin") {
                return "/Admin/Dashboard";
            }

            const returnUrl = getReturnUrl();
            if (isSafeLocalUrl(returnUrl) && !returnUrl.toLowerCase().startsWith("/admin")) {
                return returnUrl;
            }

            return "/Account/Profile";
        }

        document.getElementById("loginForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value;
            const remember = document.getElementById("remember").checked;
            const emailInvalid = !emailRegex.test(email);
            const passwordInvalid = !password;

            setError("emailError", emailInvalid);
            setError("passwordError", passwordInvalid);

            if (emailInvalid || passwordInvalid) {
                return;
            }

            loginSubmitBtn.disabled = true;
            loginSubmitText.textContent = "Đang đăng nhập...";

            Swal.fire({
                title: "Đang đăng nhập...",
                text: "Vui lòng chờ trong giây lát",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: "#ffffff",
                color: "#333333"
            });

            try {
                await setPersistence(auth, remember ? browserLocalPersistence : browserSessionPersistence);
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                const redirectUrl = await redirectByRole(userCredential.user, email);

                postForm("/Otp/SendLoginAlert", { email }).catch((error) => {
                    console.warn("Login alert email skipped:", error);
                });

                Swal.fire({
                    icon: "success",
                    title: "Đăng nhập thành công",
                    text: "Đang chuyển hướng...",
                    background: "#ffffff",
                    color: "#333333",
                    confirmButtonColor: "#f58220",
                    timer: 900,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = redirectUrl;
                });
            } catch (error) {
                console.error("Error signing in:", error);

                let message = error.message || "Email hoặc mật khẩu không chính xác.";
                if (error.code === "auth/invalid-email") {
                    message = "Email không hợp lệ.";
                } else if (error.code === "auth/user-disabled") {
                    message = "Tài khoản này đã bị khóa.";
                } else if (error.code === "auth/user-not-found") {
                    message = "Tài khoản không tồn tại.";
                } else if (error.code === "auth/wrong-password") {
                    message = "Mật khẩu không chính xác.";
                } else if (error.code === "auth/invalid-credential") {
                    message = "Email hoặc mật khẩu không chính xác.";
                }

                showError("Đăng nhập thất bại", message);
            } finally {
                loginSubmitBtn.disabled = false;
                loginSubmitText.textContent = "Đăng nhập";
            }
        });
    </script>
}
