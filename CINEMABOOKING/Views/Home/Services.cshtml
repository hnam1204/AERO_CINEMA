﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿@{
    ViewBag.Title = "Dịch Vụ - AERO Cinema";
}

<link href="@Url.Content("~/Content/services.css?v=18")" rel="stylesheet" />

<div class="services-wrapper">
    <section class="services-hero-full">
    <div class="services-hero">
        <div class="services-hero__content">
            <div class="services-hero__badge">
                <span>✦</span>
                <strong>AERO PREMIUM SERVICES</strong>
            </div>

            <h1 class="services-hero__title">
                <span>DỊCH VỤ</span>
                <span><em>ĐẲNG CẤP</em></span>
                <span>TẠI AERO CINEMA</span>
            </h1>

            <div class="services-hero__underline"></div>

            <p class="services-hero__desc">
                Trải nghiệm điện ảnh trọn vẹn hơn với đặt vé trực tuyến, ẩm thực rạp chiếu, phòng chờ cao cấp và dịch vụ tổ chức sự kiện chuyên nghiệp.
            </p>
        </div>

        <div class="services-hero__visual" aria-hidden="true">
            <div class="visual-orbit"></div>

            <div class="visual-chair">
                <div class="chair-seat"></div>
            </div>

            <div class="visual-ticket">
                <div class="ticket-logo">
                    <span>A</span>ERO
                    <small>CINEMA</small>
                </div>
                <div class="ticket-label">VÉ ĐIỆN TỬ</div>
                <div class="ticket-qr"></div>
            </div>

            <div class="visual-popcorn">
                <div class="popcorn-kernels"></div>
                <span>AERO</span>
            </div>

            <div class="visual-drink">
                <span>AERO</span>
            </div>

            <div class="visual-glass-card"></div>
            <div class="visual-platform platform-1"></div>
            <div class="visual-platform platform-2"></div>
            <div class="visual-platform platform-3"></div>
            <div class="visual-light-line"></div>
        </div>
    </div>
</section>

    <section class="services-list-section">
    <div class="services-grid" aria-label="Dịch vụ AERO Cinema">
        <article class="service-card" data-service-id="cinemunch">
            <div class="service-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <div class="service-content">
                <h3>CineMunch Eatery</h3>
                <p>Thưởng thức combo bắp nước, món ăn nhẹ và đồ uống chuẩn rạp chiếu ngay trong không gian AERO Cinema.</p>
                <ul>
                    <li>Combo bắp nước tiện lợi</li>
                    <li>Menu đa dạng, dễ chọn</li>
                    <li>Thanh toán nhanh tại quầy</li>
                    <li>Phù hợp trước và sau suất chiếu</li>
                </ul>
                <button class="service-btn" type="button" data-service-open="cinemunch" data-i18n="service_detail">Xem chi tiết</button>
            </div>
        </article>

        <article class="service-card" data-service-id="online-booking">
            <div class="service-icon">
                <i class="fas fa-mobile-alt"></i>
            </div>
            <div class="service-content">
                <h3>Đặt vé trực tuyến</h3>
                <p>Đặt vé nhanh chóng, chọn ghế yêu thích, thanh toán tiện lợi và nhận vé điện tử kèm mã QR chỉ trong vài bước.</p>
                <ul>
                    <li>Chọn phim, rạp, ngày và suất chiếu</li>
                    <li>Giữ ghế trong thời gian đặt vé</li>
                    <li>Nhận vé QR sau thanh toán</li>
                    <li>Hạn chế xếp hàng tại quầy</li>
                </ul>
                <button class="service-btn" type="button" data-service-open="online-booking" data-i18n="service_detail">Xem chi tiết</button>
            </div>
        </article>

        <article class="service-card" data-service-id="premium-lounge">
            <div class="service-icon">
                <i class="fas fa-couch"></i>
            </div>
            <div class="service-content">
                <h3>Premium Lounge</h3>
                <p>Không gian chờ cao cấp dành cho khách hàng muốn tận hưởng sự riêng tư, thoải mái và dịch vụ tốt hơn.</p>
                <ul>
                    <li>Ghế ngồi thoải mái</li>
                    <li>Không gian yên tĩnh</li>
                    <li>Phục vụ nước uống</li>
                    <li>Trải nghiệm trước giờ chiếu tốt hơn</li>
                </ul>
                <button class="service-btn" type="button" data-service-open="premium-lounge" data-i18n="service_detail">Xem chi tiết</button>
            </div>
        </article>

        <article class="service-card" data-service-id="events">
            <div class="service-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="service-content">
                <h3>Tổ chức sự kiện</h3>
                <p>AERO Cinema cung cấp dịch vụ tổ chức sự kiện, họp nhóm, sinh nhật, ra mắt sản phẩm và trình chiếu riêng tư.</p>
                <ul>
                    <li>Màn hình chiếu lớn</li>
                    <li>Âm thanh sống động</li>
                    <li>Hỗ trợ kỹ thuật</li>
                    <li>Phù hợp nhóm và doanh nghiệp</li>
                </ul>
                <button class="service-btn" type="button" data-service-open="events" data-i18n="service_detail">Xem chi tiết</button>
            </div>
        </article>
    </div>
    </section>

    <section class="services-why" aria-labelledby="servicesWhyTitle">
        <h2 id="servicesWhyTitle" data-i18n="service_why_title">Vì sao chọn dịch vụ AERO?</h2>
        <div class="services-why-grid">
            <article class="services-why-item">
                <div class="services-why-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3>Trải nghiệm nhanh chóng</h3>
                <p>Đặt vé, chọn ghế và nhận vé điện tử chỉ trong vài bước.</p>
            </article>

            <article class="services-why-item">
                <div class="services-why-icon">
                    <i class="fas fa-film"></i>
                </div>
                <h3>Không gian hiện đại</h3>
                <p>Hệ thống rạp được đầu tư về hình ảnh, âm thanh và khu vực chờ.</p>
            </article>

            <article class="services-why-item">
                <div class="services-why-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <h3>Dịch vụ linh hoạt</h3>
                <p>Phù hợp cho khách lẻ, nhóm bạn, gia đình và sự kiện doanh nghiệp.</p>
            </article>
        </div>
    </section>
</div>

<div id="serviceDetailModal" class="service-modal" aria-hidden="true">
    <div class="service-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="serviceModalTitle">
        <div class="service-modal-header">
            <div id="serviceModalIcon" class="service-modal-icon">
                <i class="fas fa-concierge-bell"></i>
            </div>
            <h2 id="serviceModalTitle" class="service-modal-title">Dịch vụ AERO Cinema</h2>
            <button type="button" class="service-modal-close" data-service-close aria-label="Đóng">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="service-modal-body">
            <p id="serviceModalDesc" class="service-modal-desc"></p>
            <ul id="serviceModalList" class="service-modal-list"></ul>
            <div class="service-modal-actions">
                <button type="button" class="service-secondary-btn" data-service-close data-i18n="close">Đóng</button>
                <button type="button" class="service-btn service-consult-btn" id="serviceConsultBtn" data-service-consult data-i18n="service_consult">Liên hệ tư vấn</button>
            </div>
        </div>
    </div>
</div>

<div id="serviceToast" class="service-toast" role="status" aria-live="polite"></div>

@section scripts {
    <script>
        (function () {
            const services = {
                "cinemunch": {
                    title: "CineMunch Eatery",
                    icon: "fas fa-utensils",
                    description: "Thưởng thức combo bắp nước, món ăn nhẹ và đồ uống chuẩn rạp chiếu ngay trong không gian AERO Cinema.",
                    bullets: [
                        "Combo bắp nước tiện lợi",
                        "Menu đa dạng, dễ chọn",
                        "Thanh toán nhanh tại quầy",
                        "Phù hợp trước và sau suất chiếu"
                    ]
                },
                "online-booking": {
                    title: "Đặt vé trực tuyến",
                    icon: "fas fa-mobile-alt",
                    description: "Đặt vé nhanh chóng, chọn ghế yêu thích, thanh toán tiện lợi và nhận vé điện tử kèm mã QR chỉ trong vài bước.",
                    bullets: [
                        "Chọn phim, rạp, ngày và suất chiếu",
                        "Giữ ghế trong thời gian đặt vé",
                        "Nhận vé QR sau thanh toán",
                        "Hạn chế xếp hàng tại quầy"
                    ]
                },
                "premium-lounge": {
                    title: "Premium Lounge",
                    icon: "fas fa-couch",
                    description: "Không gian chờ cao cấp dành cho khách hàng muốn tận hưởng sự riêng tư, thoải mái và dịch vụ tốt hơn.",
                    bullets: [
                        "Ghế ngồi thoải mái",
                        "Không gian yên tĩnh",
                        "Phục vụ nước uống",
                        "Trải nghiệm trước giờ chiếu tốt hơn"
                    ]
                },
                "events": {
                    title: "Tổ chức sự kiện",
                    icon: "fas fa-users",
                    description: "AERO Cinema cung cấp dịch vụ tổ chức sự kiện, họp nhóm, sinh nhật, ra mắt sản phẩm và trình chiếu riêng tư.",
                    bullets: [
                        "Màn hình chiếu lớn",
                        "Âm thanh sống động",
                        "Hỗ trợ kỹ thuật",
                        "Phù hợp nhóm và doanh nghiệp"
                    ]
                }
            };

            const servicesEn = {
                "cinemunch": {
                    title: "CineMunch Eatery",
                    icon: "fas fa-utensils",
                    description: "Enjoy popcorn combos, snacks, and cinema-style drinks right inside AERO Cinema.",
                    bullets: [
                        "Convenient popcorn and drink combos",
                        "A varied, easy-to-choose menu",
                        "Fast payment at the counter",
                        "Perfect before and after showtime"
                    ]
                },
                "online-booking": {
                    title: "Online Ticket Booking",
                    icon: "fas fa-mobile-alt",
                    description: "Book tickets quickly, choose your favorite seats, pay conveniently, and receive QR e-tickets in just a few steps.",
                    bullets: [
                        "Choose movie, cinema, date, and showtime",
                        "Hold seats during the booking flow",
                        "Receive QR tickets after payment",
                        "Reduce waiting time at the counter"
                    ]
                },
                "premium-lounge": {
                    title: "Premium Lounge",
                    icon: "fas fa-couch",
                    description: "A premium waiting space for guests who want more privacy, comfort, and elevated service.",
                    bullets: [
                        "Comfortable seating",
                        "Quiet lounge atmosphere",
                        "Drink service",
                        "A better pre-show experience"
                    ]
                },
                "events": {
                    title: "Private Events",
                    icon: "fas fa-users",
                    description: "AERO Cinema supports events, group meetings, birthdays, product launches, and private screenings.",
                    bullets: [
                        "Large cinema screen",
                        "Immersive sound",
                        "Technical support",
                        "Suitable for groups and businesses"
                    ]
                }
            };

            const whyContent = {
                vi: [
                    ["Trải nghiệm nhanh chóng", "Đặt vé, chọn ghế và nhận vé điện tử chỉ trong vài bước."],
                    ["Không gian hiện đại", "Hệ thống rạp được đầu tư về hình ảnh, âm thanh và khu vực chờ."],
                    ["Dịch vụ linh hoạt", "Phù hợp cho khách lẻ, nhóm bạn, gia đình và sự kiện doanh nghiệp."]
                ],
                en: [
                    ["Fast experience", "Book tickets, choose seats, and receive e-tickets in just a few steps."],
                    ["Modern spaces", "Cinema locations are invested in visuals, sound, and waiting areas."],
                    ["Flexible services", "Suitable for individual guests, groups, families, and business events."]
                ]
            };

            const modal = document.getElementById("serviceDetailModal");
            const modalIcon = document.getElementById("serviceModalIcon");
            const modalTitle = document.getElementById("serviceModalTitle");
            const modalDesc = document.getElementById("serviceModalDesc");
            const modalList = document.getElementById("serviceModalList");
            const consultBtn = document.getElementById("serviceConsultBtn");
            const toast = document.getElementById("serviceToast");

            function currentLang() {
                return window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || localStorage.getItem("language") || "vi");
            }

            function tr(key, fallback = "") {
                return window.t ? window.t(key, fallback) : (fallback || key);
            }

            function getServices() {
                return currentLang() === "en" ? servicesEn : services;
            }

            function safeText(value, fallback = "") {
                if (value === undefined || value === null) return fallback;
                const text = String(value).trim();
                if (!text || text.toLowerCase() === "undefined" || text.toLowerCase() === "null" || text === "NaN") {
                    return fallback;
                }
                return text;
            }

            function openModal(serviceId) {
                const service = getServices()[serviceId];
                if (!service) return;

                modalIcon.innerHTML = `<i class="${safeText(service.icon, "fas fa-concierge-bell")}"></i>`;
                modalTitle.textContent = safeText(service.title, tr("services_title"));
                modalDesc.textContent = safeText(service.description, tr("updated"));
                modalList.innerHTML = service.bullets
                    .filter(item => safeText(item))
                    .map(item => `<li>${safeText(item)}</li>`)
                    .join("");

                consultBtn.setAttribute("data-service-name", safeText(service.title, tr("services_title")));

                modal.classList.add("show");
                modal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            }

            function closeModal() {
                modal.classList.remove("show", "active", "open");
                modal.setAttribute("aria-hidden", "true");
                document.body.classList.remove("modal-open", "service-modal-open");
                document.body.style.overflow = "";
            }

            function showToast(message) {
                toast.textContent = message;
                toast.classList.add("show");
                clearTimeout(showToast.timer);
                showToast.timer = setTimeout(() => toast.classList.remove("show"), 2400);
            }

            function renderLocalizedServices() {
                const source = getServices();
                Object.keys(source).forEach(id => {
                    const card = document.querySelector(`[data-service-id="${id}"]`);
                    const item = source[id];
                    if (!card || !item) return;
                    card.querySelector("h3").textContent = item.title;
                    card.querySelector("p").textContent = item.description;
                    const list = card.querySelector("ul");
                    list.innerHTML = item.bullets.map(text => `<li>${safeText(text)}</li>`).join("");
                });

                const whyItems = document.querySelectorAll(".services-why-item");
                whyContent[currentLang()].forEach((item, index) => {
                    const el = whyItems[index];
                    if (!el) return;
                    el.querySelector("h3").textContent = item[0];
                    el.querySelector("p").textContent = item[1];
                });

                if (modal.classList.contains("show")) {
                    const activeId = modal.dataset.serviceId;
                    if (activeId) openModal(activeId);
                }
            }

            document.addEventListener("click", function (event) {
                const openButton = event.target.closest("[data-service-open]");
                if (openButton) {
                    modal.dataset.serviceId = openButton.dataset.serviceOpen;
                    openModal(openButton.dataset.serviceOpen);
                }

                if (event.target.closest("[data-service-close]") || event.target === modal) {
                    closeModal();
                }
            });

            let isConsultOpening = false;
            
            function escapeHtml(value) {
                return String(value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            consultBtn.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();

                if (isConsultOpening) return;
                isConsultOpening = true;

                const serviceName = this.getAttribute("data-service-name") || (currentLang() === "en" ? "AERO Cinema service" : "dịch vụ AERO Cinema");

                closeModal();

                setTimeout(() => {
                    if (window.Swal) {
                        window.Swal.fire({
                            icon: "success",
                            title: currentLang() === "en" ? "Request received" : "Đã ghi nhận yêu cầu tư vấn",
                            html: `
                                <div style="text-align:center">
                                    <p>${currentLang() === "en" ? "AERO Cinema has received your request for:" : "AERO Cinema đã ghi nhận yêu cầu tư vấn cho:"}</p>
                                    <strong style="color:#005baa">${escapeHtml(serviceName)}</strong>
                                    <p style="margin-top:10px;color:#64748b">
                                        ${currentLang() === "en" ? "Our support team will contact you shortly." : "Bộ phận hỗ trợ sẽ liên hệ với bạn trong thời gian sớm nhất."}
                                    </p>
                                </div>
                            `,
                            confirmButtonText: currentLang() === "en" ? "Got it" : "Đã hiểu",
                            confirmButtonColor: "#f58220",
                            customClass: {
                                popup: "aero-consult-swal"
                            },
                            backdrop: true,
                            allowOutsideClick: true
                        });
                    } else {
                        showToast((currentLang() === "en" ? "Request received for " : "Đã ghi nhận yêu cầu tư vấn cho ") + serviceName);
                    }
                    isConsultOpening = false;
                }, 180);
            });

            window.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && modal.classList.contains("show")) {
                    closeModal();
                }
            });

            renderLocalizedServices();
            window.addEventListener("aero:languageChanged", function () {
                if (window.applyLanguage) window.applyLanguage();
                renderLocalizedServices();
            });
        })();
    </script>
}


