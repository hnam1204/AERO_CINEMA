@section scripts {
    <script type="module">
        import { collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const db = window.db;
        const promoGrid = document.getElementById("promoGrid");
        const promoState = document.getElementById("promoState");
        const promoModal = document.getElementById("promoDetailModal");
        const promoToast = document.getElementById("promoToast");
        let rawPromotions = [];
        let promotions = [];
        let selectedPromotion = null;

        function tr(key, fallback = "") {
            return window.t ? window.t(key, fallback) : (fallback || key);
        }

        function currentLang() {
            return window.getCurrentLang ? window.getCurrentLang() : (localStorage.getItem("aero_lang") || localStorage.getItem("language") || "vi");
        }

        function safeText(value, fallback = "-") {
            if (value === undefined || value === null) return fallback;
            const text = String(value).trim();
            if (!text || text.toLowerCase() === "undefined" || text.toLowerCase() === "null" || text === "NaN" || text === "Invalid Date") {
                return fallback;
            }
            return text;
        }

        function stripHtml(value, fallback = "") {
            const text = safeText(value, fallback);
            const doc = new DOMParser().parseFromString(text, "text/html");
            return safeText(doc.body.textContent || doc.body.innerText, fallback);
        }

        function escapeHtml(value) {
            return safeText(value, "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function toDate(value) {
            if (!value) return null;
            if (value.toDate) return value.toDate();
            if (typeof value === "object" && Number.isFinite(value.seconds)) return new Date(value.seconds * 1000);
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? null : date;
        }

        function formatDate(value, fallback = "Äang cáº­p nháº­t") {
            const date = toDate(value);
            return date ? date.toLocaleDateString(currentLang() === "en" ? "en-US" : "vi-VN") : fallback;
        }

        function dateValue(value) {
            const date = toDate(value);
            return date ? date.getTime() : 0;
        }

        function getPromoTitle(item) {
            if (window.getLocalizedField) return window.getLocalizedField(item, "title", tr("promo_default_title"));
            return safeText(item.title || item.name || item.promotionTitle || item.voucherName, tr("promo_default_title"));
        }

        function getPromoDesc(item) {
            const value = window.getLocalizedField ? window.getLocalizedField(item, "description", "") : "";
            return stripHtml(value || item.description || item.summary || item.content, tr("promo_default_desc"));
        }

        function getPromoType(item) {
            return safeText(item.type || item.category || item.promotionType || tr("offer_type"), tr("offer_type"));
        }

        function getPromoCode(item) {
            return safeText(item.code || item.couponCode || item.voucherCode || item.promoCode, tr("no_code"));
        }

        function getPromoImage(item) {
            return safeText(item.desktopImageUrl || item.bannerUrl || item.imageUrl || item.thumbnailUrl, "");
        }

        function isExpired(item) {
            const expiry = toDate(item.expiredAt || item.endDate || item.validTo);
            if (!expiry) return false;
            expiry.setHours(23, 59, 59, 999);
            return expiry.getTime() < Date.now();
        }

        function normalizePromo(item) {
            const code = getPromoCode(item);
            return {
                ...item,
                title: getPromoTitle(item),
                descriptionText: getPromoDesc(item),
                typeText: getPromoType(item),
                codeText: code,
                image: getPromoImage(item),
                expireText: formatDate(item.expiredAt || item.endDate || item.validTo, tr("updated")),
                startText: formatDate(item.startDate || item.startAt || item.createdAt, tr("updated")),
                termsText: stripHtml((window.getLocalizedField ? window.getLocalizedField(item, "terms", "") : "") || item.terms || item.condition || item.conditions || item.applyCondition, tr("promo_default_terms")),
                hasCode: code !== tr("no_code"),
                expired: isExpired(item)
            };
        }

        function isPromoVisible(item) {
            if (item.isActive === false) return false;
            const status = safeText(item.status, "").toLowerCase();
            return !["inactive", "disabled", "deleted", "expired"].includes(status);
        }

        function sortPromos(a, b) {
            const aOrder = Number(a.order);
            const bOrder = Number(b.order);
            const aHasOrder = Number.isFinite(aOrder);
            const bHasOrder = Number.isFinite(bOrder);
            if (aHasOrder && bHasOrder) return aOrder - bOrder;
            if (aHasOrder) return -1;
            if (bHasOrder) return 1;
            return dateValue(b.createdAt || b.updatedAt) - dateValue(a.createdAt || a.updatedAt);
        }

        function showState(message) {
            promoGrid.innerHTML = "";
            promoState.textContent = message;
            promoState.style.display = "block";
        }

        function showLoading() {
            promoState.style.display = "none";
            promoGrid.innerHTML = Array.from({ length: 3 }, () => `
                <article class="promotion-card promo-card promo-skeleton-card">
                    <div class="promotion-card__image-wrap promo-card-media"><div class="promo-card-image"></div></div>
                    <div class="promotion-card__body promo-card-body">
                        <div class="promo-skeleton-line" style="width: 82%; height: 20px;"></div>
                        <div class="promo-skeleton-line" style="width: 96%;"></div>
                        <div class="promo-skeleton-line" style="width: 74%;"></div>
                        <div class="promo-skeleton-line" style="width: 58%; margin-top: 18px;"></div>
                    </div>
                </article>
            `).join("");
        }

        function renderImage(item) {
            const image = item.image;
            if (!image) {
                return `<div class="promo-image-fallback"><i class="fas fa-ticket-alt"></i></div>`;
            }
            return `<img class="promo-card-image" src="${escapeHtml(image)}" alt="${escapeHtml(item.title)}" loading="lazy" onerror="this.outerHTML='<div class=&quot;promo-image-fallback&quot;><i class=&quot;fas fa-ticket-alt&quot;></i></div>'" />`;
        }

        function renderPromotions(items) {
            promoState.style.display = "none";
            promoGrid.innerHTML = items.map(item => `
                <article class="promotion-card promo-card" data-id="${escapeHtml(item.id)}">
                    <div class="promotion-card__image-wrap promo-card-media">
                        <span class="promotion-card__badge promo-card-tag">${escapeHtml(item.expired ? tr("sold_out") : item.typeText)}</span>
                        ${renderImage(item)}
                    </div>
                    <div class="promotion-card__body promo-card-body">
                        <h3 class="promotion-card__title promo-card-title">${escapeHtml(item.title)}</h3>
                        <p class="promotion-card__desc promo-card-desc">${escapeHtml(item.descriptionText)}</p>
                        <div class="promo-card-meta">
                            <span class="promo-expire"><i class="far fa-calendar-alt"></i> ${escapeHtml(item.expireText)}</span>
                            <span class="promo-code">${escapeHtml(item.codeText)}</span>
                        </div>
                        <div class="promo-card-actions">
                            <button type="button" class="promo-btn promo-btn-primary" data-action="detail" data-id="${escapeHtml(item.id)}">${tr("service_detail")}</button>
                            ${item.hasCode ? `<button type="button" class="promo-btn promo-btn-copy" data-action="copy" data-code="${escapeHtml(item.codeText)}">${tr("copy_code")}</button>` : ""}
                        </div>
                    </div>
                </article>
            `).join("");
        }

        async function loadCollection(name) {
            const snap = await getDocs(collection(db, name));
            return snap.docs.map(doc => ({ id: doc.id, sourceCollection: name, ...doc.data() }));
        }

        async function loadPromotions() {
            showLoading();
            try {
                let data = await loadCollection("promotions");
                if (!data.length) {
                    data = await loadCollection("vouchers");
                }

                rawPromotions = data;
                promotions = rawPromotions
                    .filter(isPromoVisible)
                    .sort(sortPromos)
                    .map(normalizePromo);

                if (!promotions.length) {
                    showState(tr("promo_empty"));
                    return;
                }

                renderPromotions(promotions);
            } catch (error) {
                console.error("Load promotions failed:", error);
                showState(tr("promo_error"));
            }
        }

        async function copyCode(code) {
            const cleanCode = safeText(code, "");
            if (!cleanCode || cleanCode === tr("no_code")) return;
            try {
                await navigator.clipboard.writeText(cleanCode);
            } catch {
                const temp = document.createElement("textarea");
                temp.value = cleanCode;
                document.body.appendChild(temp);
                temp.select();
                document.execCommand("copy");
                temp.remove();
            }
            showToast(`${tr("copied")}: ${cleanCode}`);
        }

        function showToast(message) {
            promoToast.textContent = message;
            promoToast.classList.add("show");
            clearTimeout(showToast.timer);
            showToast.timer = setTimeout(() => promoToast.classList.remove("show"), 2200);
        }

        function openModal(item) {
            selectedPromotion = item;
            document.getElementById("promoModalTitle").textContent = item.title;
            document.getElementById("promoModalDesc").textContent = item.descriptionText;
            document.getElementById("promoModalType").textContent = item.typeText;
            document.getElementById("promoModalTime").textContent = item.startText;
            document.getElementById("promoModalExpire").textContent = item.expireText;
            document.getElementById("promoModalCode").textContent = item.codeText;
            document.getElementById("promoModalTerms").textContent = item.termsText;

            const media = document.getElementById("promoModalMedia");
            const closeButton = media.querySelector(".promo-modal-close");
            media.innerHTML = item.image
                ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" onerror="this.outerHTML='<div class=&quot;promo-image-fallback&quot;><i class=&quot;fas fa-ticket-alt&quot;></i></div>'" />`
                : `<div class="promo-image-fallback"><i class="fas fa-ticket-alt"></i></div>`;
            media.appendChild(closeButton);

            const copyBtn = document.getElementById("promoModalCopyBtn");
            copyBtn.disabled = !item.hasCode;
            copyBtn.style.display = item.hasCode ? "" : "none";
            copyBtn.textContent = item.hasCode ? tr("copy_code") : tr("no_code");

            promoModal.classList.add("show");
            promoModal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }

        function closeModal() {
            promoModal.classList.remove("show");
            promoModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        }

        document.addEventListener("click", (event) => {
            const actionButton = event.target.closest("[data-action]");
            if (actionButton?.dataset.action === "detail") {
                const item = promotions.find(p => p.id === actionButton.dataset.id);
                if (item) openModal(item);
            }

            if (actionButton?.dataset.action === "copy") {
                copyCode(actionButton.dataset.code);
            }

            if (event.target.closest("[data-promo-close]") || event.target === promoModal) {
                closeModal();
            }
        });

        document.getElementById("promoModalCopyBtn").addEventListener("click", () => {
            if (selectedPromotion) copyCode(selectedPromotion.codeText);
        });

        window.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && promoModal.classList.contains("show")) {
                closeModal();
            }
        });

        if (document.readyState === "loading") {
            window.addEventListener("DOMContentLoaded", loadPromotions);
        } else {
            loadPromotions();
        }

        window.addEventListener("aero:languageChanged", () => {
            if (window.applyLanguage) window.applyLanguage();
            if (rawPromotions.length) {
                promotions = rawPromotions.filter(isPromoVisible).sort(sortPromos).map(normalizePromo);
                renderPromotions(promotions);
                if (promoModal.classList.contains("show") && selectedPromotion) {
                    const refreshed = promotions.find(item => item.id === selectedPromotion.id);
                    if (refreshed) openModal(refreshed);
                }
            }
        });
    </script>
}

