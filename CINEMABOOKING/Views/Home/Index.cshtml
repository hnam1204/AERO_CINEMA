@section scripts {
    <script type="module">
        import { collection, getDocs, query, where, limit } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
        import { autoUpdateStatuses } from "/Scripts/aero-status-updater.js";

        const db = window.db;
        const AERO_CACHE = window.AERO_CACHE;

        // State caches
        let cachedMovies = [];
        let cachedBanners = [];
        let cachedPromotions = [];
        let cachedNews = [];
        let cachedShowtimes = [];
        let cachedCinemas = [];
        let currentTab = "now_showing";

        function formatDateSafe(dateValue) {
            if (!dateValue) return "Đang cập nhật";
            try {
                if (typeof dateValue === "string") {
                    const parts = dateValue.split("-");
                    if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
                    return dateValue;
                }
                if (dateValue.toDate) {
                    return dateValue.toDate().toLocaleDateString("vi-VN");
                }
                return new Date(dateValue).toLocaleDateString("vi-VN");
            } catch {
                return "Đang cập nhật";
            }
        }

        function formatCurrency(amount) {
            const value = Number(amount || 0);
            return value.toLocaleString("vi-VN") + "đ";
        }

        function safeText(value, fallback = "Đang cập nhật") {
            return value === undefined || value === null || value === "" ? fallback : value;
        }

        const docsToArray = (snap) => snap.docs.map(dSnap => ({ id: dSnap.id, ...dSnap.data() }));

        const getCachedDocs = async (cacheKey, queryRef, forceRefresh = false) => {
            const cached = !forceRefresh && AERO_CACHE && AERO_CACHE.get ? AERO_CACHE.get(cacheKey) : null;
            if (cached) return cached;

            const snap = await getDocs(queryRef);
            const data = docsToArray(snap);

            if (AERO_CACHE && AERO_CACHE.set) {
                AERO_CACHE.set(cacheKey, data);
            }

            return data;
        };

        // Load Homepage Main Data
        const loadHomeContent = async () => {
            try {
                // Auto update movie and showtime statuses
                await autoUpdateStatuses(db);

                const [
                    moviesData,
                    bannersData,
                    promotionsData,
                    newsData,
                    cinemasData,
                    showtimesData
                ] = await Promise.all([
                    getCachedDocs("movies", query(collection(db, "movies"), limit(30))),
                    getCachedDocs("banners", query(collection(db, "banners"), limit(5))),
                    getCachedDocs("promotions", query(collection(db, "promotions"), limit(6))),
                    getCachedDocs("news", query(collection(db, "news"), limit(6))),
                    getCachedDocs("cinemas", query(collection(db, "cinemas"), limit(12))),
                    getCachedDocs("showtimesHome", query(collection(db, "showtimes"), limit(150)))
                ]);

                cachedMovies = moviesData;
                cachedBanners = bannersData;
                cachedPromotions = promotionsData;
                cachedNews = newsData;
                cachedCinemas = cinemasData;
                // Filter client side
                cachedShowtimes = showtimesData.filter(st => ["active", "upcoming", "showing"].includes(st.status)).slice(0, 80);

                // 1. Render Hero Banner (Fade Slider)
                renderHeroSlider();

                // 2. Load Quick Booking Movies dropdown
                populateQbMovies();

                // 3. Render Tab List (Default Now Showing)
                renderMovieGrid();

                // 4. Render Promotions dynamically
                renderPromotions();

                // 4.5 Render News dynamically
                renderNews();

                // 5. Render Cinemas List dynamically (optional but consistent)
                renderCinemas();

            } catch (e) {
                console.error("Home loading error: ", e);
            }
        };

        // Render Hero Slider
        const renderHeroSlider = () => {
            const heroContainer = document.getElementById("heroSliderCinema");
            if (cachedBanners.length === 0) {
                heroContainer.innerHTML = `
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #aaa; flex-direction: column; gap: 10px;">
                        <i class="far fa-image fa-3x" style="color: var(--accent-color);"></i>
                        <span>Chưa có dữ liệu quảng cáo</span>
                    </div>
                `;
                return;
            }

            let slidesHtml = "";
            let dotsHtml = "";
            let slideIndex = 0;

            cachedBanners.forEach((b) => {
                const bannerMovieId = b && b.movieId != null ? String(b.movieId) : "";
                const movie = cachedMovies.find(m =>
                    String(m.tmdbId) === bannerMovieId ||
                    String(m.id) === bannerMovieId ||
                    String(m.docId) === bannerMovieId
                );
                const image = b.imageUrl || b.bannerUrl || b.backdropUrl || b.posterUrl || movie?.bannerUrl || movie?.backdropUrl || movie?.posterUrl || "";
                const normalizedImage = typeof image === "string" ? image.trim().toLowerCase() : "";

                if (!normalizedImage || normalizedImage === "undefined" || normalizedImage === "null") {
                    console.warn("Skipped banner because image missing", b);
                    return;
                }

                const activeClass = slideIndex === 0 ? "active" : "";
                const rating = movie?.rating || b.rating || "P";
                const ratingClass = "badge-" + String(rating).toLowerCase();
                const title = b.title || movie?.title || "AERO Cinema";
                const duration = movie?.duration || b.duration || "Đang cập nhật";
                const durationText = Number.isFinite(Number(duration)) ? `${duration} Phút` : duration;
                const genre = movie?.genre || b.subtitle || "Đang cập nhật";
                const country = movie?.country || b.country || "Đang cập nhật";
                const description = movie?.description || movie?.overview || b.subtitle || "Khám phá bộ phim bom tấn đỉnh cao tại hệ thống rạp AERO Cinema.";
                const trailerUrl = movie?.trailerUrl || b.trailerUrl || "";
                const youtubeId = window.getYoutubeId(trailerUrl);
                const trailerButtonHtml = youtubeId
                    ? `<button type="button" class="btn-hero-trailer" onclick="openTrailerModal('${youtubeId}')"><i class="fas fa-play"></i> Trailer</button>`
                    : "";
                const detailsId = movie?.id || b.movieId || "";
                const linkUrl = detailsId ? `/Movies/Details?id=${detailsId}` : "#";
                b.rating = rating;
                b.title = title;
                b.duration = Number.isFinite(Number(duration)) ? duration : "Đang cập nhật";
                b.genre = genre;
                b.country = country;
                b.description = description;

                slidesHtml += `
                    <div class="hero-slide ${activeClass}" style="background-image: url('${image}');">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <div class="hero-content-inner">
                                <span class="hero-rating ${ratingClass}">${rating}</span>
                                <h1 class="hero-title">${title}</h1>
                                <div class="hero-meta">
                                    <span><i class="far fa-clock" style="color: var(--accent-color);"></i> ${durationText}</span>
                                    <span><i class="fas fa-tags" style="color: var(--accent-color);"></i> ${genre}</span>
                                    <span><i class="fas fa-globe" style="color: var(--accent-color);"></i> ${country}</span>
                                </div>
                                <p class="hero-desc">${description}</p>
                                <div class="hero-buttons">
                                    <a href="${linkUrl}" class="btn-hero-book"><i class="fas fa-ticket-alt"></i> Mua Vé Ngay</a>
                                    ${trailerButtonHtml}
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                dotsHtml += `
                    <button type="button" class="hero-dot ${activeClass}" onclick="jumpToSlide(${slideIndex})"></button>
                `;
                slideIndex++;
            });

            if (!slidesHtml) {
                heroContainer.innerHTML = `
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #aaa; flex-direction: column; gap: 10px;">
                        <i class="far fa-image fa-3x" style="color: var(--accent-color);"></i>
                        <span>Chưa có dữ liệu quảng cáo hợp lệ</span>
                    </div>
                `;
                return;
            }

            heroContainer.innerHTML = slidesHtml + `<div class="hero-indicators">${dotsHtml}</div>`;

            // Setup autoplay logic
            window.activeSlideIdx = 0;
            window.slides = document.querySelectorAll(".hero-slide");
            window.dots = document.querySelectorAll(".hero-dot");

            if (window.sliderInterval) clearInterval(window.sliderInterval);
            window.sliderInterval = setInterval(() => {
                if (window.slides.length > 0) {
                    window.jumpToSlide((window.activeSlideIdx + 1) % window.slides.length);
                }
            }, 5000);
        };

        // Jump to specific banner slide
        window.jumpToSlide = (idx) => {
            if (!window.slides || window.slides.length === 0) return;
            window.slides[window.activeSlideIdx].classList.remove("active");
            window.dots[window.activeSlideIdx].classList.remove("active");
            window.activeSlideIdx = idx;
            window.slides[window.activeSlideIdx].classList.add("active");
            window.dots[window.activeSlideIdx].classList.add("active");
        };

        // =====================================================
        // normalizeMovieStatus: chuẩn hoá mọi variant status
        // Trả về: "now_showing" | "coming_soon" | "ended"
        // =====================================================
        const normalizeMovieStatus = (movie) => {
            const raw = (movie.status || "").toString().trim().toLowerCase();
            const NOW_SHOWING_VARIANTS = [
                "now_showing", "showing", "active", "released",
                "dang_chieu", "đang chiếu", "nowshowing", "now-showing",
                "published", "open"
            ];
            const COMING_SOON_VARIANTS = [
                "coming_soon", "upcoming", "sap_chieu", "sắp chiếu",
                "comingsoon", "coming-soon", "pre-release", "announced"
            ];

            if (NOW_SHOWING_VARIANTS.includes(raw)) return "now_showing";
            if (COMING_SOON_VARIANTS.includes(raw)) return "coming_soon";

            // Nếu status rỗng nhưng releaseDate <= hôm nay → xem là đang chiếu
            if (!raw) {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const rd = movie.releaseDate;
                if (rd) {
                    let releaseDate = null;
                    try {
                        if (typeof rd === "string") {
                            releaseDate = new Date(rd);
                        } else if (rd.toDate) {
                            releaseDate = rd.toDate();
                        } else {
                            releaseDate = new Date(rd);
                        }
                        releaseDate.setHours(0, 0, 0, 0);
                        if (releaseDate <= today) return "now_showing";
                        if (releaseDate > today) return "coming_soon";
                    } catch {}
                }
            }

            return "ended";
        };

        // Populate Quick Booking Movies select dropdown
        const populateQbMovies = () => {
            const select = document.getElementById("qbMovie");
            select.innerHTML = '<option value="" disabled selected>Chọn Phim</option>';

            // Load only now showing movies in the selector (dùng normalizeMovieStatus)
            const nowShowingList = cachedMovies.filter(m => normalizeMovieStatus(m) === "now_showing");
            nowShowingList.forEach(m => {
                const opt = document.createElement("option");
                opt.value = m.id;
                opt.innerText = m.title || "Đang cập nhật";
                select.appendChild(opt);
            });
        };

        // Quick Booking selections logic chains
        window.onQbMovieChange = () => {
            const movieId = document.getElementById("qbMovie").value;
            const selectCinema = document.getElementById("qbCinema");
            const selectDate = document.getElementById("qbDate");
            const selectShowtime = document.getElementById("qbShowtime");
            const submitBtn = document.getElementById("qbSubmitBtn");

            // Reset downstream selections
            selectCinema.innerHTML = '<option value="" disabled selected>Chọn Rạp</option>';
            selectCinema.disabled = true;
            selectDate.innerHTML = '<option value="" disabled selected>Chọn Ngày</option>';
            selectDate.disabled = true;
            selectShowtime.innerHTML = '<option value="" disabled selected>Chọn Suất</option>';
            selectShowtime.disabled = true;
            submitBtn.disabled = true;

            // Load cinemas that have showtimes for this movie
            const activeCinemaIds = cachedCinemas.filter(c => c.status !== "inactive").map(c => c.id);
            const validCinemas = {};
            cachedShowtimes.forEach(st => {
                if (st.movieId === movieId && ["active", "upcoming", "showing"].includes(st.status) && activeCinemaIds.includes(st.cinemaId)) {
                    validCinemas[st.cinemaId] = st.cinemaName;
                }
            });

            if (Object.keys(validCinemas).length > 0) {
                selectCinema.innerHTML = '<option value="" disabled selected>Chọn Rạp</option>';
                for (const cId in validCinemas) {
                    const opt = document.createElement("option");
                    opt.value = cId;
                    opt.innerText = validCinemas[cId];
                    selectCinema.appendChild(opt);
                }
                selectCinema.disabled = false;
            } else {
                selectCinema.innerHTML = '<option value="" disabled selected>Không có lịch chiếu</option>';
            }
        };

        window.onQbCinemaChange = () => {
            const movieId = document.getElementById("qbMovie").value;
            const cinemaId = document.getElementById("qbCinema").value;
            const selectDate = document.getElementById("qbDate");
            const selectShowtime = document.getElementById("qbShowtime");
            const submitBtn = document.getElementById("qbSubmitBtn");

            // Reset
            selectDate.innerHTML = '<option value="" disabled selected>Chọn Ngày</option>';
            selectDate.disabled = true;
            selectShowtime.innerHTML = '<option value="" disabled selected>Chọn Suất</option>';
            selectShowtime.disabled = true;
            submitBtn.disabled = true;

            // Get valid dates
            const validDates = {};
            cachedShowtimes.forEach(st => {
                if (st.movieId === movieId && st.cinemaId === cinemaId && ["active", "upcoming", "showing"].includes(st.status)) {
                    validDates[st.date] = st.date;
                }
            });

            const sortedDates = Object.keys(validDates).sort();

            if (sortedDates.length > 0) {
                selectDate.innerHTML = '<option value="" disabled selected>Chọn Ngày</option>';
                sortedDates.forEach(dateStr => {
                    const opt = document.createElement("option");
                    opt.value = dateStr;
                    // Format to DD/MM
                    const parts = dateStr.split("-");
                    opt.innerText = `${parts[2]}/${parts[1]}`;
                    selectDate.appendChild(opt);
                });
                selectDate.disabled = false;
            } else {
                selectDate.innerHTML = '<option value="" disabled selected>Không có ngày chiếu</option>';
            }
        };

        window.onQbDateChange = () => {
            const movieId = document.getElementById("qbMovie").value;
            const cinemaId = document.getElementById("qbCinema").value;
            const dateStr = document.getElementById("qbDate").value;
            const selectShowtime = document.getElementById("qbShowtime");
            const submitBtn = document.getElementById("qbSubmitBtn");

            // Reset
            selectShowtime.innerHTML = '<option value="" disabled selected>Chọn Suất</option>';
            selectShowtime.disabled = true;
            submitBtn.disabled = true;

            // Get valid showtimes slots
            const slots = [];
            cachedShowtimes.forEach(st => {
                if (st.movieId === movieId && st.cinemaId === cinemaId && st.date === dateStr && ["active", "upcoming", "showing"].includes(st.status)) {
                    slots.push({ id: st.id, time: st.time });
                }
            });

            slots.sort((a, b) => a.time.localeCompare(b.time));

            if (slots.length > 0) {
                selectShowtime.innerHTML = '<option value="" disabled selected>Chọn Suất</option>';
                slots.forEach(slot => {
                    const opt = document.createElement("option");
                    opt.value = slot.id;
                    opt.innerText = slot.time;
                    selectShowtime.appendChild(opt);
                });
                selectShowtime.disabled = false;
            } else {
                selectShowtime.innerHTML = '<option value="" disabled selected>Hết suất</option>';
            }
        };

        window.onQbShowtimeChange = () => {
            document.getElementById("qbSubmitBtn").disabled = false;
        };

        window.goToQuickBookingSeats = () => {
            const showtimeId = document.getElementById("qbShowtime").value;
            if (showtimeId) {
                window.location.href = `/Booking/Seats?showtimeId=${showtimeId}`;
            }
        };

        // Switch Phim Đang Chiếu vs Phim Sắp Chiếu tabs
        window.switchMovieTab = (tab, btnElement) => {
            document.querySelectorAll(".movie-tab-btn").forEach(btn => btn.classList.remove("active"));
            btnElement.classList.add("active");
            currentTab = tab;
            renderMovieGrid();
        };

        // Render movies grid based on selected tab
        const renderMovieGrid = () => {
            const container = document.getElementById("moviesGridDisplay");

            // ✅ FIX: Dùng normalizeMovieStatus thay vì so sánh cứng m.status === currentTab
            const allMovies = cachedMovies;
            const nowShowingMovies = allMovies.filter(m => normalizeMovieStatus(m) === "now_showing");
            const comingSoonMovies = allMovies.filter(m => normalizeMovieStatus(m) === "coming_soon");

            // ✅ DEBUG LOG — xóa sau khi xác nhận OK
            console.log("[AERO DEBUG] All movies loaded:", allMovies.length);
            console.log("[AERO DEBUG] Now showing:", nowShowingMovies.length);
            console.log("[AERO DEBUG] Coming soon:", comingSoonMovies.length);
            console.log("[AERO DEBUG] Movie status list:", allMovies.map(m => ({ title: m.title, status: m.status, releaseDate: m.releaseDate })));

            const filteredMovies = currentTab === "now_showing" ? nowShowingMovies : comingSoonMovies;

            if (filteredMovies.length === 0) {
                const emptyMsg = currentTab === "now_showing"
                    ? "Hiện chưa có phim đang chiếu."
                    : "Hiện chưa có phim sắp chiếu.";
                container.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-sub);">
                        <i class="far fa-folder-open fa-3x" style="color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
                        <span>${emptyMsg}</span>
                    </div>
                `;
                return;
            }

            let html = "";
            filteredMovies.forEach(m => {
                const normalizedStatus = normalizeMovieStatus(m);
                const ratingVal = m.rating || "P";
                const ratingClass = "badge-" + ratingVal.toLowerCase().replace(/[^a-z0-9]/g, "");
                const posterSrc = m.posterUrl || m.imageUrl || m.bannerUrl || "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=85";
                const titleVal = m.title || "Đang cập nhật";
                const genreVal = (m.genre || "Đang cập nhật").split(",")[0].trim();
                const durationVal = m.duration ? `${m.duration} Phút` : "Đang cập nhật";

                const buyBtnHtml = normalizedStatus === "now_showing"
                    ? `<a href="/Movies/Details?id=${m.id}#booking-section" class="btn-card-buy"><i class="fas fa-ticket-alt"></i> Đặt Vé</a>`
                    : `<button class="btn-card-buy" style="background-color:#999; border-color:#999; cursor:not-allowed;"><i class="far fa-bell"></i> Sắp Chiếu</button>`;

                html += `
                    <div class="movie-display-card">
                        <div class="card-poster-wrapper">
                            <span class="card-rating-tag ${ratingClass}">${ratingVal}</span>
                            <img src="${posterSrc}" alt="${titleVal}" loading="lazy" decoding="async"
                                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=85'" />
                        </div>
                        <div class="card-details">
                            <h3 class="card-movie-title" title="${titleVal}">${titleVal}</h3>
                            <div class="card-movie-meta">
                                <span>${genreVal}</span>
                                <span><i class="far fa-clock"></i> ${durationVal}</span>
                            </div>
                            <div class="card-actions-row">
                                <a href="/Movies/Details?id=${m.id}" class="btn-card-detail">Chi Tiết</a>
                                ${buyBtnHtml}
                            </div>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        };

        // Render Promotions dynamically
        const renderPromotions = () => {
            const container = document.getElementById("offersGrid");
            if (cachedPromotions.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: span 3; text-align: center; padding: 40px; color: var(--text-sub);">
                        <i class="fas fa-gift fa-3x" style="color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
                        <span>Hiện chưa có chương trình khuyến mãi nào.</span>
                    </div>
                `;
                return;
            }

            let html = "";
            cachedPromotions.forEach(p => {
                html += `
                    <div class="offer-card">
                        <div class="offer-img-box">
                            <img src="${p.imageUrl}" alt="${p.title}" loading="lazy" decoding="async" onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=85'" />
                        </div>
                        <div class="offer-text-box">
                            <h3 class="offer-title">${p.title}</h3>
                            <p class="offer-desc">${p.description}</p>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        };

        // Render News dynamically
        const renderNews = () => {
            const container = document.getElementById("newsGrid");
            if (!container) return;
            if (cachedNews.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: span 3; text-align: center; padding: 40px; color: var(--text-sub);">
                        <i class="far fa-newspaper fa-3x" style="color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
                        <span>Hiện chưa có tin tức điện ảnh mới.</span>
                    </div>
                `;
                return;
            }

            let html = "";
            cachedNews.forEach(n => {
                html += `
                    <div class="offer-card">
                        <div class="offer-img-box">
                            <img src="${n.imageUrl}" alt="${n.title}" loading="lazy" decoding="async" onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=85'" />
                        </div>
                        <div class="offer-text-box">
                            <h3 class="offer-title">${n.title}</h3>
                            <p class="offer-desc">${n.description}</p>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        };

        // Populate system cinemas
        const renderCinemas = () => {
            const container = document.getElementById("cinemasGrid");
            const activeCinemas = cachedCinemas.filter(c => c.status !== "inactive");
            if (activeCinemas.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: span 2; text-align: center; padding: 40px; color: var(--text-sub);">
                        <i class="fas fa-film fa-3x" style="color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
                        <span>Chưa tìm thấy thông tin cụm rạp.</span>
                    </div>
                `;
                return;
            }

            let html = "";
            activeCinemas.forEach(c => {
                html += `
                    <div class="cinema-card">
                        <div>
                            <h3 class="cinema-name">${c.name}</h3>
                            <div class="cinema-info-row">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>${c.address}</span>
                            </div>
                            <div class="cinema-info-row">
                                <i class="fas fa-phone-alt"></i>
                                <span>Hotline: ${c.phone || '1900 1234'}</span>
                            </div>
                        </div>
                        <a href="/Showtimes" class="btn-cinema-schedule">Xem lịch chiếu</a>
                    </div>
                `;
            });
            container.innerHTML = html;
        };

        // On Page Load Init
        window.addEventListener('DOMContentLoaded', () => {
            loadHomeContent();
        });
    </script>

    <script>
        // YouTube helper
        window.getYoutubeId = function(url) {
            if (!url) return '';
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : url;
        };

        // Trailer Popup functions
        function openTrailerModal(videoId) {
            var modal = document.getElementById("trailerModalPopup");
            var frame = document.getElementById("trailerVideoFrame");
            if (!modal || !frame) return;

            frame.src = "https://www.youtube.com/embed/" + videoId + "?autoplay=1";
            modal.style.display = "flex";
            setTimeout(function() {
                modal.classList.add("show");
            }, 50);
        }

        function closeTrailerModal() {
            var modal = document.getElementById("trailerModalPopup");
            var frame = document.getElementById("trailerVideoFrame");
            if (!modal || !frame) return;

            modal.classList.remove("show");
            setTimeout(function() {
                frame.src = "";
                modal.style.display = "none";
            }, 400);
        }
    </script>
}
