@{
    ViewBag.Title = "Trang Chủ";
}

<link href="~/Content/home-performance.css" rel="stylesheet" />

<!-- 1. HERO SLIDER BANNER (AERO Full-Width Style) -->
<section class="aero-hero-galaxy" id="aeroHeroFullwidth">
    <div class="aero-hero-stage" id="aeroHeroStage">
        <!-- Prev Arrow -->
        <button type="button" class="aero-hero-arrow aero-hero-prev" id="aeroHeroPrev" aria-label="Banner trước">
            <i class="fas fa-chevron-left"></i>
        </button>

        <!-- Slide Track -->
        <div class="aero-hero-track" id="aeroHeroTrack">
            <!-- slides rendered by JS -->
            <article class="aero-hero-slide active">
                <img src="data:image/svg+xml;charset=UTF-8,%3Csvg xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22 width%3D%221600%22 height%3D%22650%22 viewBox%3D%220 0 1600 650%22%3E%3Cdefs%3E%3ClinearGradient id%3D%22g%22 x1%3D%220%22 x2%221%22%3E%3Cstop offset%3D%220%22 stop-color%3D%22%230f172a%22%2F%3E%3Cstop offset%3D%220.55%22 stop-color%3D%22%23111827%22%2F%3E%3Cstop offset%3D%221%22 stop-color%3D%22%23005baa%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect width%3D%221600%22 height%3D%22650%22 fill%3D%22url(%23g)%22%2F%3E%3Ctext x%3D%2250%25%22 y%3D%2248%25%22 dominant-baseline%3D%22middle%22 text-anchor%3D%22middle%22 fill%3D%22%23ffffff%22 font-size%3D%2258%22 font-family%3D%22Arial%22 font-weight%3D%22800%22%3EAERO CINEMA%3C%2Ftext%3E%3Ctext x%3D%2250%25%22 y%3D%2258%25%22 dominant-baseline%3D%22middle%22 text-anchor%3D%22middle%22 fill%3D%22%23f58220%22 font-size%3D%2224%22 font-family%3D%22Arial%22 font-weight%3D%22700%22%3EPremium Movie Experience%3C%2Ftext%3E%3C%2Fsvg%3E" alt="AERO Cinema" loading="eager" onerror="window.heroHandleImgError && window.heroHandleImgError(this)" />
            </article>
        </div>

        <!-- Next Arrow -->
        <button type="button" class="aero-hero-arrow aero-hero-next" id="aeroHeroNext" aria-label="Banner tiếp theo">
            <i class="fas fa-chevron-right"></i>
        </button>

        <!-- Dots -->
        <div class="aero-hero-dots" id="aeroHeroDots"></div>
    </div>

    <!-- Quick Booking Overlay Bar -->
    <div class="aero-quick-booking-wrap">
        <div class="aero-quick-booking">
            <!-- Phim -->
            <div class="quick-booking-field">
                <span class="quick-step">1</span>
                <select id="qbMovie" onchange="onQbMovieChange()">
                    <option value="" disabled selected data-i18n="select_movie">Chọn Phim</option>
                </select>
            </div>
            <!-- Rạp -->
            <div class="quick-booking-field">
                <span class="quick-step">2</span>
                <select id="qbCinema" disabled onchange="onQbCinemaChange()">
                    <option value="" disabled selected data-i18n="select_cinema">Chọn Rạp</option>
                </select>
            </div>
            <!-- Ngày -->
            <div class="quick-booking-field">
                <span class="quick-step">3</span>
                <select id="qbDate" disabled onchange="onQbDateChange()">
                    <option value="" disabled selected data-i18n="select_date">Chọn Ngày</option>
                </select>
            </div>
            <!-- Suất -->
            <div class="quick-booking-field">
                <span class="quick-step">4</span>
                <select id="qbShowtime" disabled onchange="onQbShowtimeChange()">
                    <option value="" disabled selected data-i18n="select_showtime">Chọn Suất</option>
                </select>
            </div>
            <!-- Button -->
            <button id="qbSubmitBtn" class="hero-booking-btn" disabled onclick="goToQuickBookingSeats()">
                <i class="fas fa-ticket-alt"></i> <span data-i18n="buy_now">Mua Vé Ngay</span>
            </button>
        </div>
    </div>
</section>


