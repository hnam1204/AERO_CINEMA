@{
    ViewBag.Title = "Cụm Rạp - AERO Cinema";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@600;700;800;900&display=swap');

    body {
        background-color: #f8fafc !important;
    }

    .aero-cinema-board-section {
        max-width: 1120px;
        margin: 34px auto 52px;
        padding: 0 16px;
        font-family: 'Be Vietnam Pro', 'Inter', 'Roboto', Arial, sans-serif;
    }

    .aero-cinema-board {
        background:
            radial-gradient(circle at 88% 14%, rgba(0,91,170,.12), transparent 32%),
            radial-gradient(circle at 12% 86%, rgba(255,122,26,.10), transparent 28%),
            linear-gradient(135deg, #ffffff 0%, #fbfdff 48%, #edf6ff 100%);
        border: 1px solid rgba(226,232,240,.92);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 26px 68px rgba(15,23,42,.10);
    }

    .aero-cinema-board-inner {
        position: relative;
        padding: 14px 12px 10px;
    }

    .aero-cinema-board h1 {
        margin: 0 0 26px;
        text-align: center;
        font-size: clamp(30px, 3.2vw, 44px);
        line-height: 1.18;
        letter-spacing: .01em;
        font-weight: 900;
        color: #07142f;
        text-shadow: none;
    }

    .cinema-city-grid {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .cinema-city-item {
        min-height: 42px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: rgba(255,255,255,.92);
        color: #334155;
        text-align: center;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        padding: 0 18px;
        box-shadow: 0 8px 18px rgba(15,23,42,.04);
        transition: transform .2s ease, color .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .cinema-city-item:hover {
        color: #c75f08;
        border-color: rgba(255,122,26,.35);
        background: rgba(255,122,26,.10);
        transform: translateY(-1px);
    }

    .cinema-city-item.active {
        color: #fff;
        border-color: #ff7a1a;
        background: linear-gradient(135deg, #ff7a1a, #ff9f43);
        box-shadow: 0 14px 28px rgba(255,122,26,.28);
    }

    .cinema-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(148,163,184,.34), transparent);
        margin: 26px auto 24px;
        max-width: 820px;
    }

    .cinema-branch-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .cinema-branch-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-height: 220px;
        padding: 22px;
        border: 1px solid rgba(226,232,240,.95);
        border-radius: 18px;
        background: rgba(255,255,255,.94);
        box-shadow: 0 18px 42px rgba(15,23,42,.07);
    }

    .cinema-branch-card h2 {
        margin: 0;
        color: #07142f;
        font-size: 20px;
        line-height: 1.35;
        font-weight: 900;
    }

    .cinema-branch-meta {
        display: grid;
        gap: 9px;
        margin: 0;
        color: #475569;
        font-size: 14px;
        line-height: 1.55;
        font-weight: 650;
    }

    .cinema-branch-meta span {
        display: flex;
        gap: 9px;
        align-items: flex-start;
    }

    .cinema-branch-meta i {
        width: 17px;
        margin-top: 3px;
        color: #ff7a1a;
        text-align: center;
        flex: 0 0 17px;
    }

    .cinema-branch-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: auto;
    }

    .cinema-branch-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 900;
        line-height: 1.2;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
    }

    .cinema-branch-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .cinema-branch-btn--primary {
        color: #fff;
        background: linear-gradient(135deg, #ff7a1a, #ff9f43);
        box-shadow: 0 13px 26px rgba(255,122,26,.24);
    }

    .cinema-branch-btn--primary:hover {
        color: #fff;
        box-shadow: 0 16px 34px rgba(255,122,26,.30);
    }

    .cinema-branch-btn--outline {
        color: #07142f;
        border: 1px solid rgba(255,122,26,.38);
        background: #fff;
    }

    .cinema-branch-btn--outline:hover {
        color: #ff7a1a;
        border-color: rgba(255,122,26,.62);
        background: rgba(255,122,26,.08);
    }

    .cinema-empty-state {
        grid-column: 1 / -1;
        color: #64748b;
        font-size: 14px;
        font-weight: 700;
        text-align: center;
        padding: 20px;
    }

    @@media (max-width: 991px) {
        .aero-cinema-board {
            padding: 24px;
        }

        .aero-cinema-board-inner {
            padding: 8px 4px;
        }

        .aero-cinema-board h1 {
            margin-bottom: 22px;
        }

        .cinema-branch-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .aero-cinema-board-section {
            margin: 24px auto 42px;
            padding: 0 12px;
        }

        .aero-cinema-board {
            padding: 20px 14px;
            border-radius: 22px;
        }

        .aero-cinema-board-inner {
            padding: 4px 2px;
        }

        .aero-cinema-board h1 {
            font-size: 28px;
        }

        .cinema-city-grid {
            justify-content: center;
            gap: 10px;
        }

        .cinema-city-item {
            min-height: 40px;
            padding: 0 14px;
            font-size: 14px;
        }

        .cinema-branch-card {
            padding: 18px;
        }

        .cinema-branch-actions {
            flex-direction: column;
        }

        .cinema-branch-btn {
            width: 100%;
        }
    }
</style>

<section class="aero-cinema-board-section">
    <div class="aero-cinema-board">
        <div class="aero-cinema-board-inner">
            <h1 data-i18n="cinemas_title">HỆ THỐNG CỤM RẠP AERO CINEMA</h1>

            <div id="cinemaCityGrid" class="cinema-city-grid">
                <div class="cinema-empty-state" data-i18n="cinema_loading">Đang tải hệ thống rạp...</div>
            </div>

            <div class="cinema-divider"></div>

            <div id="cinemaBranchGrid" class="cinema-branch-grid">
                <!-- render danh sách rạp thuộc tỉnh đang chọn -->
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script type="module">
        import { collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        let allCinemas = [];
        let selectedCity = "";

        function safeText(value, fallback = "") {
            if (value === undefined || value === null) return fallback;
            const text = String(value).trim();
            if (!text || text.toLowerCase() === "undefined" || text.toLowerCase() === "null") return fallback;
            return text;
        }

        function tr(key, fallback = "") {
            return window.t ? window.t(key, fallback) : (fallback || key);
        }

        function getLocalized(item, field, fallback = "") {
            if (window.getLocalizedField) return window.getLocalizedField(item, field, fallback);
            return safeText(item?.[field], fallback);
        }

        function getCinemaName(c) {
            return getLocalized(c, "name", safeText(c.cinemaName, "AERO Cinema"));
        }

        function getCinemaCity(c) {
            return getLocalized(c, "city", safeText(c.province || c.locationCity, window.getCurrentLang && window.getCurrentLang() === "en" ? "Other" : "Khác"));
        }

        function getCinemaMapUrl(c) {
            const directUrl = safeText(c.mapUrl || c.googleMapUrl || c.mapsUrl || c.mapLink);
            if (directUrl) return directUrl;

            const lat = safeText(c.latitude || c.lat);
            const lng = safeText(c.longitude || c.lng || c.lon);
            if (lat && lng) return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${lat},${lng}`)}`;

            const query = `${getCinemaName(c)} ${getLocalized(c, "address", "")}`.trim();
            return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query || "AERO Cinema")}`;
        }

        function escapeHtml(value) {
            return safeText(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/`/g, "&#96;");
        }

        async function fetchCinemas() {
            try {
                const db = window.db;
                if (!db) {
                    setTimeout(fetchCinemas, 200);
                    return;
                }

                const cinemasRef = collection(db, "cinemas");
                const snapshot = await getDocs(cinemasRef);
                
                allCinemas = snapshot.docs
                    .map(doc => ({ id: doc.id, ...doc.data() }))
                    .filter(c => c.isActive !== false && String(c.status || "active").toLowerCase() !== "inactive" && String(c.status || "active").toLowerCase() !== "disabled" && String(c.status || "active").toLowerCase() !== "deleted");

                if (allCinemas.length === 0) {
                    document.getElementById("cinemaCityGrid").innerHTML = `<div class="cinema-empty-state">${tr("cinema_empty")}</div>`;
                    return;
                }

                // Sort overall by name
                allCinemas.sort((a, b) => getCinemaName(a).localeCompare(getCinemaName(b), "vi"));

                renderCityGrid();
            } catch (error) {
                console.error("Error loading cinemas:", error);
                document.getElementById("cinemaCityGrid").innerHTML = `<div class="cinema-empty-state">${tr("cinema_error")}</div>`;
            }
        }

        function renderCityGrid() {
            const container = document.getElementById("cinemaCityGrid");
            
            const cities = [...new Set(allCinemas.map(getCinemaCity))].sort((a, b) => a.localeCompare(b, "vi"));
            
            if (cities.length === 0) return;

            if (!selectedCity || !cities.includes(selectedCity)) {
                selectedCity = cities[0];
            }

            container.innerHTML = cities.map(city => {
                const isActive = city === selectedCity;
                return `
                    <button type="button" 
                            class="cinema-city-item ${isActive ? "active" : ""}" 
                            data-city="${escapeAttribute(city)}">
                        ${escapeHtml(city)}
                    </button>
                `;
            }).join("");

            container.querySelectorAll(".cinema-city-item").forEach(btn => {
                btn.addEventListener("click", () => {
                    selectedCity = btn.dataset.city;
                    container.querySelectorAll(".cinema-city-item").forEach(b => b.classList.toggle("active", b === btn));
                    renderBranches();
                });
            });

            renderBranches();
        }

        function renderBranches() {
            const grid = document.getElementById("cinemaBranchGrid");
            if (!grid) return;

            const cityCinemas = allCinemas.filter(c => getCinemaCity(c) === selectedCity);

            if (cityCinemas.length === 0) {
                grid.innerHTML = `<div class="cinema-empty-state">${tr("cinema_no_branch")}</div>`;
                return;
            }

            grid.innerHTML = cityCinemas.map(c => {
                const id = escapeAttribute(c.id);
                const name = escapeHtml(getCinemaName(c));
                const address = escapeHtml(getLocalized(c, "address", tr("cinema_address_updating")));
                const hotline = escapeHtml(safeText(c.hotline || c.phone || c.phoneNumber, "1900 1234"));
                const mapUrl = escapeAttribute(getCinemaMapUrl(c));

                return `
                    <article class="cinema-branch-card">
                        <h2>${name}</h2>
                        <div class="cinema-branch-meta">
                            <span><i class="fas fa-map-marker-alt"></i><span>${address}</span></span>
                            <span><i class="fas fa-phone-alt"></i><span>${hotline}</span></span>
                        </div>
                        <div class="cinema-branch-actions">
                            <a class="cinema-branch-btn cinema-branch-btn--primary" href="/Showtimes?cinemaId=${id}">Xem lịch chiếu</a>
                            <a class="cinema-branch-btn cinema-branch-btn--outline" href="${mapUrl}" target="_blank" rel="noopener">Xem bản đồ</a>
                        </div>
                    </article>
                `;
            }).join("");
        }

        // Initialize loading
        window.addEventListener("DOMContentLoaded", () => {
            fetchCinemas();
        });

        window.addEventListener("aero:languageChanged", () => {
            if (window.applyLanguage) window.applyLanguage();
            if (allCinemas.length) {
                renderCityGrid();
            } else {
                const cityGrid = document.getElementById("cinemaCityGrid");
                if (cityGrid) cityGrid.innerHTML = `<div class="cinema-empty-state">${tr("cinema_loading")}</div>`;
            }
        });
    </script>
}
