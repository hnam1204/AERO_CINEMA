@{
    ViewBag.Title = "Cụm Rạp - AERO Cinema";
}

<style>
    .cinemas-wrapper {
        margin-bottom: 50px;
    }

    .cinemas-hero {
        position: relative;
        padding: 60px 20px;
        text-align: center;
        background: linear-gradient(135deg, #1e1b29 0%, #0b0b0d 100%);
        border-radius: 12px;
        margin-bottom: 40px;
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .cinemas-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(41, 188, 234, 0.05) 0%, transparent 60%);
        pointer-events: none;
    }

    .cinemas-hero h1 {
        font-size: 36px;
        font-weight: 900;
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 15px;
        letter-spacing: 1px;
    }

    .cinemas-hero h1 span {
        color: var(--accent-color);
    }

    .cinemas-hero p {
        font-size: 15px;
        color: var(--text-sub);
        max-width: 600px;
        margin: 0 auto;
    }

    /* CINEMAS SECTION */
    .cinemas-list {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .cinema-branch-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 30px;
        align-items: center;
        transition: var(--transition);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .cinema-branch-card:hover {
        transform: translateY(-3px);
        border-color: var(--accent-color);
        box-shadow: 0 15px 35px rgba(41, 188, 234, 0.12);
    }

    .cinema-img-box {
        width: 100%;
        aspect-ratio: 16/10;
        border-radius: 8px;
        overflow: hidden;
        background-color: #111;
        border: 1px solid rgba(255,255,255,0.03);
    }

    .cinema-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cinema-branch-info h3 {
        font-size: 18px;
        font-weight: 800;
        color: #fff;
        text-transform: uppercase;
        margin-bottom: 15px;
        letter-spacing: 0.5px;
    }

    .cinema-branch-meta {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px 25px;
    }

    .cinema-meta-item {
        display: flex;
        gap: 12px;
        font-size: 13px;
        color: var(--text-sub);
        line-height: 1.5;
    }

    .cinema-meta-item i {
        color: var(--accent-color);
        font-size: 14px;
        width: 16px;
        text-align: center;
        margin-top: 2px;
    }

    .cinema-meta-item strong {
        color: #fff;
        display: block;
        margin-bottom: 4px;
    }

    @@media (max-width: 992px) {
        .cinema-branch-card {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .cinema-img-box {
            max-width: 400px;
            margin: 0 auto;
        }
    }

    @@media (max-width: 576px) {
        .cinema-branch-meta {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        .cinemas-hero h1 {
            font-size: 28px;
        }
    }
</style>

<div class="cinemas-wrapper">
    
    <!-- Hero Header -->
    <div class="cinemas-hero">
        <h1>Hệ thống cụm rạp <span>AERO Cinema</span></h1>
        <p>Không gian chiếu phim sang trọng, trang thiết bị tối tân, mang đến những giờ phút giải trí thăng hoa nhất.</p>
    </div>

    <!-- Cinemas List -->
    <div class="cinemas-list">
        
        <!-- Branch 1: Ninh Kieu -->
        <div class="cinema-branch-card">
            <div class="cinema-img-box">
                <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80" alt="AERO Cinema Ninh Kieu" />
            </div>
            <div class="cinema-branch-info">
                <h3>AERO Cinema Ninh Kiều</h3>
                <div class="cinema-branch-meta">
                    <div class="cinema-meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <strong>Địa chỉ</strong>
                            <span>Tầng 5, TTTM Sense City, Số 1 Đại lộ Hòa Bình, Ninh Kiều, Cần Thơ</span>
                        </div>
                    </div>
                    
                    <div class="cinema-meta-item">
                        <i class="fas fa-phone-alt"></i>
                        <div>
                            <strong>Hotline</strong>
                            <span>1900 1234 (Nhánh 1)</span>
                        </div>
                    </div>

                    <div class="cinema-meta-item">
                        <i class="fas fa-clock"></i>
                        <div>
                            <strong>Giờ mở cửa</strong>
                            <span>08:30 - 23:30 (Mở cửa tất cả các ngày trong tuần)</span>
                        </div>
                    </div>

                    <div class="cinema-meta-item">
                        <i class="fas fa-film"></i>
                        <div>
                            <strong>Thông tin phòng chiếu</strong>
                            <span>06 phòng chiếu hiện đại (bao gồm 01 phòng Premium VIP Lounge)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Branch 2: Aero Cinema Landmark -->
        <div class="cinema-branch-card">
            <div class="cinema-img-box">
                <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=600&q=80" alt="AERO Cinema Landmark" />
            </div>
            <div class="cinema-branch-info">
                <h3>AERO Cinema Landmark</h3>
                <div class="cinema-branch-meta">
                    <div class="cinema-meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <strong>Địa chỉ</strong>
                            <span>Tầng B1, Tòa nhà Landmark 81, Vinhomes Central Park, Bình Thạnh, TP. Hồ Chí Minh</span>
                        </div>
                    </div>
                    
                    <div class="cinema-meta-item">
                        <i class="fas fa-phone-alt"></i>
                        <div>
                            <strong>Hotline</strong>
                            <span>1900 1234 (Nhánh 2)</span>
                        </div>
                    </div>

                    <div class="cinema-meta-item">
                        <i class="fas fa-clock"></i>
                        <div>
                            <strong>Giờ mở cửa</strong>
                            <span>08:00 - 00:30 (Mở cửa suốt dịp Lễ/Tết)</span>
                        </div>
                    </div>

                    <div class="cinema-meta-item">
                        <i class="fas fa-film"></i>
                        <div>
                            <strong>Thông tin phòng chiếu</strong>
                            <span>08 phòng chiếu 4K Laser (bao gồm 01 phòng IMAX đẳng cấp)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
