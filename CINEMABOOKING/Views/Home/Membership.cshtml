@{
    ViewBag.Title = "Chương Trình Thành Viên - AERO Cinema";
}

<style>
    .member-wrapper {
        margin-bottom: 50px;
    }

    .member-hero {
        position: relative;
        padding: 60px 20px;
        text-align: center;
        background: linear-gradient(135deg, #1e1b29 0%, #0b0b0d 100%);
        border-radius: 12px;
        margin-bottom: 40px;
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .member-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(41, 188, 234, 0.05) 0%, transparent 60%);
        pointer-events: none;
    }

    .member-hero h1 {
        font-size: 36px;
        font-weight: 900;
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 15px;
        letter-spacing: 1px;
    }

    .member-hero h1 span {
        color: var(--accent-color);
    }

    .member-hero p {
        font-size: 15px;
        color: var(--text-sub);
        max-width: 600px;
        margin: 0 auto;
    }

    /* CARD MEMBERSHIP TIERS */
    .tiers-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 45px;
    }

    .tier-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px 20px;
        text-align: center;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 380px;
    }

    .tier-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
    }

    .tier-card.silver::before { background-color: #bdc3c7; }
    .tier-card.gold::before { background: linear-gradient(90deg, #f1c40f, #f39c12); }
    .tier-card.platinum::before { background: linear-gradient(90deg, #9b59b6, #8e44ad); }
    .tier-card.diamond::before { background: linear-gradient(90deg, #29bcea, #3498db); }

    .tier-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.3);
    }

    .tier-card.silver:hover { border-color: #bdc3c7; }
    .tier-card.gold:hover { border-color: #f1c40f; }
    .tier-card.platinum:hover { border-color: #9b59b6; }
    .tier-card.diamond:hover { border-color: #29bcea; }

    .tier-name {
        font-size: 18px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 10px;
        letter-spacing: 1px;
    }

    .tier-card.silver .tier-name { color: #bdc3c7; }
    .tier-card.gold .tier-name { color: #f1c40f; }
    .tier-card.platinum .tier-name { color: #9b59b6; }
    .tier-card.diamond .tier-name { color: #29bcea; }

    .tier-requirement {
        font-size: 12px;
        color: var(--text-sub);
        margin-bottom: 25px;
    }

    .tier-benefits {
        padding: 0;
        margin: 0 0 25px 0;
        list-style: none;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .tier-benefits li {
        font-size: 12px;
        color: #ddd;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        line-height: 1.4;
    }

    .tier-benefits li i {
        color: var(--accent-color);
        font-size: 11px;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .btn-tier-action {
        padding: 10px 20px;
        font-size: 12px;
        font-weight: 700;
        border-radius: 20px;
        text-transform: uppercase;
        border: 1px solid rgba(255,255,255,0.1);
        background: transparent;
        color: #fff;
        transition: var(--transition);
        cursor: pointer;
    }

    .tier-card:hover .btn-tier-action {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        box-shadow: 0 5px 15px rgba(214, 0, 0, 0.4);
    }

    /* POINTS SECTION */
    .points-info-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .points-title {
        font-size: 18px;
        font-weight: 800;
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 20px;
        border-left: 3px solid var(--primary-color);
        padding-left: 12px;
    }

    .points-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .point-step-item {
        text-align: center;
    }

    .point-step-icon {
        width: 50px;
        height: 50px;
        background-color: rgba(41, 188, 234, 0.08);
        border: 1px solid rgba(41, 188, 234, 0.15);
        color: var(--accent-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin: 0 auto 15px auto;
    }

    .point-step-item h4 {
        font-size: 14px;
        font-weight: 800;
        color: #fff;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .point-step-item p {
        font-size: 12px;
        color: var(--text-sub);
        line-height: 1.6;
    }

    @@media (max-width: 1200px) {
        .tiers-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
    }

    @@media (max-width: 768px) {
        .points-steps {
            grid-template-columns: 1fr;
            gap: 25px;
        }
    }

    @@media (max-width: 576px) {
        .tiers-grid {
            grid-template-columns: 1fr;
        }
        .member-hero h1 {
            font-size: 28px;
        }
    }
</style>

<div class="member-wrapper">
    
    <!-- Hero Header -->
    <div class="member-hero">
        <h1>Chương Trình Thành Viên <span>AERO Star</span></h1>
        <p>Đăng ký thành viên, tích lũy điểm chi tiêu và nâng cấp thứ hạng để nhận ngập tràn ưu đãi vé xem phim & combo bắp nước.</p>
    </div>

    <!-- Tiers Grid -->
    <div class="tiers-grid">
        
        <!-- Tier 1: Silver -->
        <div class="tier-card silver">
            <div>
                <h3 class="tier-name">Silver</h3>
                <span class="tier-requirement">Hạng mặc định sau đăng ký</span>
            </div>
            <ul class="tier-benefits">
                <li><i class="fas fa-star"></i> Tích lũy 5% giá trị giao dịch thành điểm thưởng</li>
                <li><i class="fas fa-star"></i> Quà tặng sinh nhật thành viên</li>
                <li><i class="fas fa-star"></i> Nhận tin khuyến mãi sớm nhất</li>
            </ul>
            <button class="btn-tier-action" onclick="window.location.href='/Account/Register'">Đăng Ký Ngay</button>
        </div>

        <!-- Tier 2: Gold -->
        <div class="tier-card gold">
            <div>
                <h3 class="tier-name">Gold</h3>
                <span class="tier-requirement">Chi tiêu từ 1.000.000đ / năm</span>
            </div>
            <ul class="tier-benefits">
                <li><i class="fas fa-star"></i> Tích lũy 7% giá trị giao dịch thành điểm</li>
                <li><i class="fas fa-star"></i> Tặng 01 vé xem phim 2D sinh nhật</li>
                <li><i class="fas fa-star"></i> Giảm 5% khi mua các combo bắp nước</li>
                <li><i class="fas fa-star"></i> Tham gia các buổi chiếu sớm VIP</li>
            </ul>
            <button class="btn-tier-action" onclick="window.location.href='/Account/Login'">Xem Chi Tiết</button>
        </div>

        <!-- Tier 3: Platinum -->
        <div class="tier-card platinum">
            <div>
                <h3 class="tier-name">Platinum</h3>
                <span class="tier-requirement">Chi tiêu từ 3.000.000đ / năm</span>
            </div>
            <ul class="tier-benefits">
                <li><i class="fas fa-star"></i> Tích lũy 10% giá trị giao dịch thành điểm</li>
                <li><i class="fas fa-star"></i> Tặng 02 vé xem phim 2D sinh nhật</li>
                <li><i class="fas fa-star"></i> Giảm 10% khi mua các combo bắp nước</li>
                <li><i class="fas fa-star"></i> Ưu tiên quầy vé & quầy bắp nước VIP</li>
            </ul>
            <button class="btn-tier-action" onclick="window.location.href='/Account/Login'">Xem Chi Tiết</button>
        </div>

        <!-- Tier 4: Diamond -->
        <div class="tier-card diamond">
            <div>
                <h3 class="tier-name">Diamond</h3>
                <span class="tier-requirement">Chi tiêu từ 8.000.000đ / năm</span>
            </div>
            <ul class="tier-benefits">
                <li><i class="fas fa-star"></i> Tích lũy 15% giá trị giao dịch thành điểm</li>
                <li><i class="fas fa-star"></i> Tặng 02 cặp vé xem phim 2D sinh nhật</li>
                <li><i class="fas fa-star"></i> Giảm 15% khi mua bắp nước</li>
                <li><i class="fas fa-star"></i> Phòng chờ VIP riêng biệt tại cụm rạp lớn</li>
            </ul>
            <button class="btn-tier-action" onclick="window.location.href='/Account/Login'">Xem Chi Tiết</button>
        </div>

    </div>

    <!-- Points accumulation rules -->
    <div class="points-info-card">
        <h3 class="points-title">Cơ chế quy đổi & Sử dụng điểm thưởng</h3>
        <div class="points-steps">
            
            <div class="point-step-item">
                <div class="point-step-icon"><i class="fas fa-shopping-cart"></i></div>
                <h4>1. Chi Tiêu Tích Điểm</h4>
                <p>Mỗi khi đặt vé xem phim online hoặc mua combo trực tiếp tại quầy, bạn chỉ cần xuất trình mã thành viên để hệ thống tự động cộng điểm.</p>
            </div>

            <div class="point-step-item">
                <div class="point-step-icon"><i class="fas fa-calculator"></i></div>
                <h4>2. Công Thức Quy Đổi</h4>
                <p>1 điểm tích lũy có giá trị tương đương 1.000đ khi quy đổi. Điểm thưởng sẽ được tích lũy vào ví điểm của bạn trên hệ thống.</p>
            </div>

            <div class="point-step-item">
                <div class="point-step-icon"><i class="fas fa-gift"></i></div>
                <h4>3. Đổi Quà Giá Trị</h4>
                <p>Sử dụng điểm tích lũy để đổi vé xem phim 2D/3D miễn phí, đổi combo bắp nước hoặc nhận các quà tặng độc quyền từ hãng phim.</p>
            </div>

        </div>
    </div>

</div>
