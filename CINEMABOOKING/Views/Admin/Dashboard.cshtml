@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Dashboard";
}

<div class="dashboard-page">
    <!-- Hero Section -->
    <section class="hero" aria-labelledby="heroTitle">
        <div>
            <h1 id="heroTitle">Hệ thống quản trị AERO Cinema</h1>
            <p>Trang điều khiển trung tâm tối ưu hóa hiệu năng, theo dõi dữ liệu người dùng, doanh thu trực tuyến, trạng thái hệ thống và báo cáo phân tích theo thời gian thực.</p>
        </div>
    </section>

    <!-- Overview Grid -->
    <div class="section-title">
        <h2>Thống kê tổng quan</h2>
        <span>Realtime Metrics</span>
    </div>
    <section class="admin-stats-grid" id="overviewCards">
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-users"></i></span>
            <span class="stat-label">Người dùng</span>
            <div class="stat-value skeleton" id="statUsers">0</div>
            <div class="stat-note" id="statUsersSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-film"></i></span>
            <span class="stat-label">Tổng phim</span>
            <div class="stat-value skeleton" id="statMovies">0</div>
            <div class="stat-note" id="statMoviesSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-coins"></i></span>
            <span class="stat-label">Tổng Doanh thu</span>
            <div class="stat-value skeleton" id="statRevenue">0đ</div>
            <div class="stat-note" id="statRevenueSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-ticket-alt"></i></span>
            <span class="stat-label">Vé bán ra</span>
            <div class="stat-value skeleton" id="statTickets">0</div>
            <div class="stat-note" id="statTicketsSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-burger"></i></span>
            <span class="stat-label">Doanh thu combo</span>
            <div class="stat-value skeleton" id="statComboRevenue">0đ</div>
            <div class="stat-note" id="statComboRevenueSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-cart-shopping"></i></span>
            <span class="stat-label">Combo đã bán</span>
            <div class="stat-value skeleton" id="statComboSold">0</div>
            <div class="stat-note" id="statComboSoldSub">Đang cập nhật...</div>
        </div>
        <div class="admin-stat-card">
            <span class="stat-icon"><i class="fas fa-fire"></i></span>
            <span class="stat-label">Top combo</span>
            <div class="stat-value skeleton" id="statTopCombo">-</div>
            <div class="stat-note" id="statTopComboSub">Bán chạy nhất</div>
        </div>
    </section>

    <!-- Main Grid: Main panel (Left) + Sidebar widgets (Right) -->
    <div class="dashboard-grid">
        <!-- Main Column (Left) -->
        <div class="dashboard-main-panel">
            <!-- Tabbed Chart Container -->
            <div class="chart-tabs-container">
                <div class="chart-tabs-header">
                    <h3>Phân tích dữ liệu & Xu hướng</h3>
                    <nav class="chart-tabs-nav" aria-label="Bộ lọc biểu đồ">
                        <button type="button" class="chart-tab-btn active" data-chart="revenue30">Doanh thu 30 ngày</button>
                        <button type="button" class="chart-tab-btn" data-chart="revenue12">Doanh thu 12 tháng</button>
                        <button type="button" class="chart-tab-btn" data-chart="bookingTrend">Xu hướng đặt vé</button>
                        <button type="button" class="chart-tab-btn" data-chart="ticketTrend">Xu hướng bán vé</button>
                        <button type="button" class="chart-tab-btn" data-chart="topMovies">Top 10 phim</button>
                        <button type="button" class="chart-tab-btn" data-chart="topCombos">Top combo</button>
                        <button type="button" class="chart-tab-btn" data-chart="topCinemas">Top 10 rạp</button>
                        <button type="button" class="chart-tab-btn" data-chart="payments">Cổng thanh toán</button>
                        <button type="button" class="chart-tab-btn" data-chart="userGrowth">Tăng trưởng user</button>
                    </nav>
                </div>
                <div class="chart-body-wrapper">
                    <canvas id="dashboardAnalyticChart"></canvas>
                </div>
            </div>

            <!-- Recent Bookings Table -->
            <section class="admin-card">
                <div class="panel-head d-flex justify-content-between align-items-center mb-3">
                    <h3 class="m-0">Booking mới nhận</h3>
                    <span id="bookingTableCount" class="badge bg-primary">0 đơn mới</span>
                </div>
                <div class="admin-table-wrap m-0">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Phim / Rạp</th>
                                <th>Ghế</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody id="latestBookingsBody">
                            <tr>
                                <td colspan="7"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><span>Đang tải booking...</span></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Recent Activity Logs Table -->
            <section class="admin-card">
                <div class="panel-head d-flex justify-content-between align-items-center mb-3">
                    <h3 class="m-0">Hoạt động hệ thống mới nhất</h3>
                    <span class="badge bg-secondary">Bảo mật thời gian thực</span>
                </div>
                <div class="admin-table-wrap m-0">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Nhân viên</th>
                                <th>Thao tác</th>
                                <th>Phân mục</th>
                                <th>Mã tài liệu</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody id="latestActivitiesBody">
                            <tr>
                                <td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><span>Đang tải hoạt động...</span></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="dashboard-sidebar-panel">
            <!-- System Health Monitor -->
            <article class="sidebar-widget" aria-labelledby="healthWidgetTitle">
                <div class="sidebar-widget-header">
                    <h3 id="healthWidgetTitle">Trạng thái hệ thống</h3>
                    <span>Realtime Monitor</span>
                </div>
                <div class="health-status-row">
                    <div class="health-status-label">
                        <span class="pulse-indicator green" id="healthPulse"></span>
                        Kết nối Firestore
                    </div>
                    <div class="health-status-value" id="healthStatus">Hoạt động</div>
                </div>
                <div class="health-status-row">
                    <div class="health-status-label"><i class="fas fa-server"></i> Độ trễ API</div>
                    <div class="health-status-value" id="healthPing">-- ms</div>
                </div>
                <div class="health-status-row">
                    <div class="health-status-label"><i class="fas fa-database"></i> Dữ liệu offline</div>
                    <div class="health-status-value" id="healthOffline">Đã bật</div>
                </div>
                <div class="health-status-row">
                    <div class="health-status-label"><i class="fas fa-signal"></i> Active Listeners</div>
                    <div class="health-status-value" id="healthListeners">10 listeners</div>
                </div>
            </article>

            <!-- Usage indicators -->
            <article class="sidebar-widget" aria-labelledby="usageWidgetTitle">
                <div class="sidebar-widget-header">
                    <h3 id="usageWidgetTitle">Hạn ngạch & Sử dụng</h3>
                    <span>Firebase Limits</span>
                </div>
                <div class="usage-monitor-item">
                    <div class="usage-monitor-info">
                        <span class="usage-monitor-name">Firestore Reads (Truy vấn)</span>
                        <span class="usage-monitor-percent" id="readsPercent">--%</span>
                    </div>
                    <div class="usage-progress-bar">
                        <div class="usage-progress-fill success" id="readsBar" style="width: 0%;"></div>
                    </div>
                </div>
                <div class="usage-monitor-item">
                    <div class="usage-monitor-info">
                        <span class="usage-monitor-name">Firestore Writes (Ghi đè)</span>
                        <span class="usage-monitor-percent" id="writesPercent">--%</span>
                    </div>
                    <div class="usage-progress-bar">
                        <div class="usage-progress-fill" id="writesBar" style="width: 0%;"></div>
                    </div>
                </div>
                <div class="usage-monitor-item">
                    <div class="usage-monitor-info">
                        <span class="usage-monitor-name">Bộ nhớ hình ảnh (Storage)</span>
                        <span class="usage-monitor-percent" id="storagePercent">--%</span>
                    </div>
                    <div class="usage-progress-bar">
                        <div class="usage-progress-fill" id="storageBar" style="width: 0%;"></div>
                    </div>
                </div>
            </article>

            <!-- Top List Widget -->
            <article class="sidebar-widget" aria-labelledby="topWidgetTitle">
                <div class="sidebar-widget-header">
                    <h3 id="topWidgetTitle">Top rạp & combo</h3>
                    <span>Xếp hạng doanh thu</span>
                </div>
                <div class="top-items-list" id="topCinemasList">
                    <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><span>Đang tải xếp hạng...</span></div>
                </div>
            </article>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="module">
        import {
            collection,
            onSnapshot,
            query,
            orderBy,
            limit
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        // Active collection tracking
        const collections = ["users", "movies", "showtimes", "bookings", "tickets", "payments", "promotions", "news", "activity_logs", "cinemas", "food_combos"];
        const state = {
            users: [],
            movies: [],
            showtimes: [],
            bookings: [],
            tickets: [],
            payments: [],
            promotions: [],
            news: [],
            activity_logs: [],
            cinemas: [],
            food_combos: [],
            loaded: new Set(),
            unsubscribers: [],
            currentActiveChartTab: "revenue30",
            chartInstance: null,
            chartRenderTimer: null,
            isRenderingChart: false,
            firestoreReadCount: 0
        };

        const formatMoney = (val) => {
            return Number(val || 0).toLocaleString("vi-VN") + "đ";
        };

        const safeString = (val, fallback = "-") => {
            return val === undefined || val === null || val === "" ? fallback : val;
        };

        const toDateObject = (val) => {
            if (!val) return null;
            if (val.toDate) return val.toDate();
            if (typeof val === "number") return new Date(val);
            const parsed = new Date(val);
            return Number.isNaN(parsed.getTime()) ? null : parsed;
        };

        const formatFullDateTime = (val) => {
            const d = toDateObject(val);
            return d ? d.toLocaleString("vi-VN", {
                hour: "2-digit",
                minute: "2-digit",
                day: "2-digit",
                month: "2-digit",
                year: "numeric"
            }) : "Đang cập nhật";
        };

        const normalizeValue = (val) => String(val || "").trim().toLowerCase();

        const getTimestamp = (item) => {
            const d = toDateObject(item.createdAt || item.updatedAt || item.timestamp || item.date);
            return d ? d.getTime() : 0;
        };

        const getPaidPayments = () => {
            return state.payments.filter(p => normalizeValue(p.status) === "paid" || normalizeValue(p.status) === "success" || normalizeValue(p.status) === "completed");
        };

        const getCompletedBookings = () => {
            return state.bookings.filter(b => normalizeValue(b.status) === "paid" || normalizeValue(b.status) === "completed" || normalizeValue(b.status) === "success");
        };

        function getComboStats() {
            const map = {};
            let sold = 0;
            let revenue = 0;
            getCompletedBookings().forEach(b => {
                revenue += Number(b.comboTotal || 0);
                (Array.isArray(b.comboItems) ? b.comboItems : []).forEach(item => {
                    const key = item.comboId || item.id || item.name || "unknown";
                    const name = item.name || key;
                    const qty = Number(item.quantity || 0);
                    const total = Number(item.total || (Number(item.price || 0) * qty));
                    if (!map[key]) map[key] = { id: key, name, qty: 0, revenue: 0 };
                    map[key].qty += qty;
                    map[key].revenue += total;
                    sold += qty;
                });
            });
            if (!sold && state.food_combos.length) {
                state.food_combos.forEach(c => {
                    const qty = Number(c.soldCount || 0);
                    const total = Number(c.price || 0) * qty;
                    if (!map[c.id]) map[c.id] = { id: c.id, name: c.name || c.id, qty: 0, revenue: 0 };
                    map[c.id].qty += qty;
                    map[c.id].revenue += total;
                    sold += qty;
                    revenue += total;
                });
            }
            const top = Object.values(map).sort((a, b) => b.qty - a.qty || b.revenue - a.revenue);
            return { sold, revenue, top, map };
        }

        function getStatusText(status) {
            const value = normalizeValue(status);
            const map = {
                pending: "Chờ xử lý",
                unpaid: "Chờ thanh toán",
                paid: "Đã thanh toán",
                completed: "Hoàn tất",
                success: "Thành công",
                cancelled: "Đã hủy",
                canceled: "Đã hủy",
                rejected: "Từ chối",
                active: "Hoạt động"
            };
            return map[value] || safeString(status, "Không rõ");
        }

        function getStatusClass(status) {
            const value = normalizeValue(status);
            if (["pending", "unpaid"].includes(value)) return "warning";
            if (["paid", "completed", "success", "active"].includes(value)) return "success";
            if (["cancelled", "canceled", "rejected"].includes(value)) return "danger";
            return "secondary";
        }

        // Realtime stats calculator
        function updateSummaryCards() {
            const paid = getPaidPayments();
            const totalRev = paid.reduce((sum, p) => sum + Number(p.amount || p.totalPrice || 0), 0);
            
            const now = new Date();
            let todayRev = 0;
            paid.forEach(p => {
                const d = toDateObject(p.createdAt || p.updatedAt);
                if (d && d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear()) {
                    todayRev += Number(p.amount || p.totalPrice || 0);
                }
            });

            // Set text & remove skeletons
            setTextElement("statUsers", state.users.length.toLocaleString("vi-VN"));
            setTextElement("statUsersSub", `${state.users.filter(u => normalizeValue(u.status) === "active").length} tài khoản hoạt động`);

            setTextElement("statMovies", state.movies.length.toLocaleString("vi-VN"));
            setTextElement("statMoviesSub", `${state.movies.filter(m => normalizeValue(m.status) === "active" || normalizeValue(m.status) === "now_showing").length} phim đang chiếu`);

            setTextElement("statRevenue", formatMoney(totalRev));
            setTextElement("statRevenueSub", `Hôm nay: ${formatMoney(todayRev)}`);

            // Compute ticket count from seats in completed bookings
            let ticketCount = 0;
            getCompletedBookings().forEach(b => {
                if (Array.isArray(b.seats)) ticketCount += b.seats.length;
                else if (typeof b.seats === "string" && b.seats.trim()) ticketCount += b.seats.split(",").length;
            });
            setTextElement("statTickets", ticketCount.toLocaleString("vi-VN"));
            setTextElement("statTicketsSub", `Đơn đặt: ${state.bookings.length} | Hủy: ${state.bookings.filter(b => normalizeValue(b.status) === "cancelled").length}`);

            const comboStats = getComboStats();
            const topCombo = comboStats.top[0];
            setTextElement("statComboRevenue", formatMoney(comboStats.revenue));
            setTextElement("statComboRevenueSub", `${comboStats.top.length} combo có doanh số`);
            setTextElement("statComboSold", comboStats.sold.toLocaleString("vi-VN"));
            setTextElement("statComboSoldSub", `Tổng combo đã bán`);
            setTextElement("statTopCombo", topCombo ? topCombo.name : "-");
            setTextElement("statTopComboSub", topCombo ? `${topCombo.qty.toLocaleString("vi-VN")} phần | ${formatMoney(topCombo.revenue)}` : "Chưa có dữ liệu");
        }

        function setTextElement(id, text) {
            const el = document.getElementById(id);
            if (el) {
                el.innerText = text;
                el.classList.remove("skeleton");
            }
        }

        // Render widgets (Recent bookings, activity logs, sidebars)
        function renderWidgets() {
            // 1. Recent bookings (last 10)
            const bookingsBody = document.getElementById("latestBookingsBody");
            if (bookingsBody) {
                const recentBookings = [...state.bookings]
                    .sort((a, b) => getTimestamp(b) - getTimestamp(a))
                    .slice(0, 10);
                
                document.getElementById("bookingTableCount").innerText = `${state.bookings.filter(b => normalizeValue(b.status) === "pending").length} đơn mới`;

                if (!recentBookings.length) {
                    bookingsBody.innerHTML = `<tr><td colspan="7"><div class="empty-state"><span>Chưa có booking nào.</span></div></td></tr>`;
                } else {
                    bookingsBody.innerHTML = recentBookings.map(b => {
                        let seatsStr = "-";
                        if (Array.isArray(b.seats)) seatsStr = b.seats.join(", ");
                        else if (typeof b.seats === "string") seatsStr = b.seats;

                        return `
                            <tr>
                                <td data-label="Mã đơn"><strong class="text-primary">${b.id.substring(0, 8)}...</strong></td>
                                <td data-label="Khách hàng"><div class="main-cell"><strong>${safeString(b.userEmail)}</strong><span>${safeString(b.userPhone || b.userId || "")}</span></div></td>
                                <td data-label="Phim / Rạp"><div class="main-cell"><strong>${safeString(b.movieTitle)}</strong><span>${safeString(b.cinemaName)}</span></div></td>
                                <td data-label="Ghế">${seatsStr}</td>
                                <td data-label="Tổng tiền"><strong>${formatMoney(b.totalPrice)}</strong></td>
                                <td data-label="Trạng thái"><span class="admin-badge ${getStatusClass(b.status)}">${getStatusText(b.status)}</span></td>
                                <td data-label="Thời gian">${formatFullDateTime(b.createdAt)}</td>
                            </tr>
                        `;
                    }).join("");
                }
            }

            // 2. Recent Activity Logs (last 10)
            const activitiesBody = document.getElementById("latestActivitiesBody");
            if (activitiesBody) {
                const recentActs = [...state.activity_logs]
                    .sort((a, b) => getTimestamp(b) - getTimestamp(a))
                    .slice(0, 10);

                if (!recentActs.length) {
                    activitiesBody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><span>Chưa có lịch sử hoạt động.</span></div></td></tr>`;
                } else {
                    activitiesBody.innerHTML = recentActs.map(act => {
                        const email = act.email || "system@aerocinema.vn";
                        const action = act.action || "update";
                        const coll = act.collection || "system";
                        
                        let badgeClass = "secondary";
                        if (action === "create" || action === "add") badgeClass = "success";
                        else if (action === "delete" || action === "remove") badgeClass = "danger";
                        else if (action === "update" || action === "edit") badgeClass = "primary";

                        return `
                            <tr>
                                <td data-label="Nhân viên"><strong>${email}</strong></td>
                                <td data-label="Thao tác"><span class="admin-badge ${badgeClass}">${action.toUpperCase()}</span></td>
                                <td data-label="Phân mục"><span class="badge bg-dark">${coll}</span></td>
                                <td data-label="Mã tài liệu"><span class="text-muted font-monospace" style="font-size:11px;">${safeString(act.docId, "global")}</span></td>
                                <td data-label="Thời gian">${formatFullDateTime(act.timestamp)}</td>
                            </tr>
                        `;
                    }).join("");
                }
            }

            // 3. Top Cinemas sidebar
            const cinemasList = document.getElementById("topCinemasList");
            if (cinemasList) {
                const cinemaStats = {};
                // Initialize from existing cinemas
                state.cinemas.forEach(c => {
                    cinemaStats[c.name] = { name: c.name, city: c.city, count: 0, revenue: 0 };
                });

                // Group bookings
                getCompletedBookings().forEach(b => {
                    const name = b.cinemaName || "Khác";
                    if (!cinemaStats[name]) {
                        cinemaStats[name] = { name: name, city: "AERO System", count: 0, revenue: 0 };
                    }
                    cinemaStats[name].count++;
                    cinemaStats[name].revenue += Number(b.totalPrice || 0);
                });

                const sortedCinemas = Object.values(cinemaStats)
                    .sort((a, b) => b.revenue - a.revenue)
                    .slice(0, 5);

                if (!sortedCinemas.length) {
                    cinemasList.innerHTML = `<div class="empty-state"><span>Chưa có dữ liệu rạp.</span></div>`;
                } else {
                    const topCombos = getComboStats().top.slice(0, 5);
                    const comboHtml = topCombos.length ? `
                        <div style="margin:14px 0 8px;font-size:12px;font-weight:800;color:var(--admin-subtle);text-transform:uppercase;">Top combo bán chạy</div>
                        ${topCombos.map((c, idx) => `
                            <div class="top-item">
                                <div class="top-item-avatar">${idx + 1}</div>
                                <div class="top-item-info">
                                    <p class="top-item-title">${safeString(c.name)}</p>
                                    <p class="top-item-subtitle">${c.qty.toLocaleString("vi-VN")} phần đã bán</p>
                                </div>
                                <div class="top-item-value">${formatMoney(c.revenue)}</div>
                            </div>
                        `).join("")}
                    ` : "";
                    cinemasList.innerHTML = sortedCinemas.map((c, idx) => `
                        <div class="top-item">
                            <div class="top-item-avatar">${idx + 1}</div>
                            <div class="top-item-info">
                                <p class="top-item-title">${c.name}</p>
                                <p class="top-item-subtitle">${c.city} · ${c.count} vé đặt</p>
                            </div>
                            <div class="top-item-value">${formatMoney(c.revenue)}</div>
                        </div>
                    `).join("") + comboHtml;
                }
            }

            // 4. Usage Metrics Calculations (simulate based on dataset doc sizes + basic rules)
            // Firebase limits simulation: reads (50k/day for free tier), writes (20k/day), storage (5GB)
            const totalDocs = state.users.length + state.movies.length + state.showtimes.length + state.bookings.length + state.tickets.length + state.payments.length + state.promotions.length + state.news.length + state.activity_logs.length + state.cinemas.length + state.food_combos.length;
            
            // Reads = current reads count, writes = bookings + logs * 1.5, storage = movies count * 0.4MB + banners
            state.firestoreReadCount = totalDocs;
            const simulatedWrites = (state.bookings.length + state.activity_logs.length) * 2;
            const simulatedStorage = (state.movies.length * 480 * 1024) + (state.promotions.length * 200 * 1024) + 24 * 1024 * 1024; // in bytes

            const readPct = Math.min(100, Math.round((state.firestoreReadCount / 50000) * 100));
            const writePct = Math.min(100, Math.round((simulatedWrites / 20000) * 100));
            const storagePct = Math.min(100, Math.round((simulatedStorage / (5 * 1024 * 1024 * 1024)) * 100 * 10) / 10);

            document.getElementById("readsPercent").innerText = `${readPct}% (${state.firestoreReadCount.toLocaleString("vi-VN")} / 50K)`;
            document.getElementById("readsBar").style.width = `${readPct}%`;

            document.getElementById("writesPercent").innerText = `${writePct}% (${simulatedWrites.toLocaleString("vi-VN")} / 20K)`;
            document.getElementById("writesBar").style.width = `${writePct}%`;

            document.getElementById("storagePercent").innerText = `${storagePct}% (${(simulatedStorage / (1024 * 1024)).toFixed(1)}MB / 5GB)`;
            document.getElementById("storageBar").style.width = `${storagePct}%`;
        }

        // Chart generators
        function buildChartData(tabName) {
            const colors = window.AeroAdmin?.getThemeColors() || { primary: "#f97316", muted: "#94a3b8" };
            const paid = getPaidPayments();

            if (tabName === "revenue30") {
                // Past 30 days daily revenue
                const days = [];
                for (let i = 29; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    d.setHours(0,0,0,0);
                    days.push({
                        date: d,
                        label: d.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" }),
                        revenue: 0
                    });
                }
                paid.forEach(p => {
                    const pd = toDateObject(p.createdAt || p.updatedAt);
                    if (!pd) return;
                    const item = days.find(day => day.date.getDate() === pd.getDate() && day.date.getMonth() === pd.getMonth() && day.date.getFullYear() === pd.getFullYear());
                    if (item) item.revenue += Number(p.amount || p.totalPrice || 0);
                });

                return {
                    type: "line",
                    data: {
                        labels: days.map(d => d.label),
                        datasets: [{
                            label: "Doanh thu ngày",
                            data: days.map(d => d.revenue),
                            borderColor: colors.primary,
                            backgroundColor: "rgba(249, 115, 22, 0.12)",
                            fill: true,
                            tension: 0.4,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        plugins: {
                            tooltip: { callbacks: { label: (ctx) => formatMoney(ctx.raw) } }
                        }
                    }
                };
            }

            if (tabName === "revenue12") {
                // Past 12 months revenue
                const months = [];
                for (let i = 11; i >= 0; i--) {
                    const d = new Date();
                    d.setMonth(d.getMonth() - i);
                    months.push({
                        year: d.getFullYear(),
                        month: d.getMonth(),
                        label: d.toLocaleDateString("vi-VN", { month: "short", year: "2-digit" }),
                        revenue: 0
                    });
                }
                paid.forEach(p => {
                    const pd = toDateObject(p.createdAt || p.updatedAt);
                    if (!pd) return;
                    const item = months.find(m => m.month === pd.getMonth() && m.year === pd.getFullYear());
                    if (item) item.revenue += Number(p.amount || p.totalPrice || 0);
                });

                return {
                    type: "bar",
                    data: {
                        labels: months.map(m => m.label),
                        datasets: [{
                            label: "Doanh thu tháng",
                            data: months.map(m => m.revenue),
                            backgroundColor: colors.primary,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        plugins: {
                            tooltip: { callbacks: { label: (ctx) => formatMoney(ctx.raw) } }
                        }
                    }
                };
            }

            if (tabName === "bookingTrend") {
                // Past 30 days bookings count
                const days = [];
                for (let i = 29; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    d.setHours(0,0,0,0);
                    days.push({
                        date: d,
                        label: d.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" }),
                        count: 0
                    });
                }
                state.bookings.forEach(b => {
                    const bd = toDateObject(b.createdAt);
                    if (!bd) return;
                    const item = days.find(day => day.date.getDate() === bd.getDate() && day.date.getMonth() === bd.getMonth() && day.date.getFullYear() === bd.getFullYear());
                    if (item) item.count++;
                });

                return {
                    type: "line",
                    data: {
                        labels: days.map(d => d.label),
                        datasets: [{
                            label: "Số đơn đặt vé",
                            data: days.map(d => d.count),
                            borderColor: "#3b82f6",
                            backgroundColor: "rgba(59, 130, 246, 0.1)",
                            fill: true,
                            tension: 0.35
                        }]
                    }
                };
            }

            if (tabName === "ticketTrend") {
                // Past 30 days seats booked
                const days = [];
                for (let i = 29; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    d.setHours(0,0,0,0);
                    days.push({
                        date: d,
                        label: d.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" }),
                        count: 0
                    });
                }
                getCompletedBookings().forEach(b => {
                    const bd = toDateObject(b.createdAt);
                    if (!bd) return;
                    const item = days.find(day => day.date.getDate() === bd.getDate() && day.date.getMonth() === bd.getMonth() && day.date.getFullYear() === bd.getFullYear());
                    if (item) {
                        if (Array.isArray(b.seats)) item.count += b.seats.length;
                        else if (typeof b.seats === "string" && b.seats.trim()) item.count += b.seats.split(",").length;
                    }
                });

                return {
                    type: "line",
                    data: {
                        labels: days.map(d => d.label),
                        datasets: [{
                            label: "Số vé bán",
                            data: days.map(d => d.count),
                            borderColor: "#10b981",
                            backgroundColor: "rgba(16, 185, 129, 0.1)",
                            fill: true,
                            tension: 0.35
                        }]
                    }
                };
            }

            if (tabName === "topMovies") {
                // Top 10 movies by seats booked
                const moviesMap = {};
                state.movies.forEach(m => {
                    moviesMap[m.title] = { title: m.title, count: 0 };
                });
                getCompletedBookings().forEach(b => {
                    const title = b.movieTitle || "Khác";
                    if (!moviesMap[title]) moviesMap[title] = { title: title, count: 0 };
                    
                    let seatsCount = 0;
                    if (Array.isArray(b.seats)) seatsCount = b.seats.length;
                    else if (typeof b.seats === "string" && b.seats.trim()) seatsCount = b.seats.split(",").length;
                    
                    moviesMap[title].count += seatsCount;
                });

                const sorted = Object.values(moviesMap)
                    .sort((a,b) => b.count - a.count)
                    .slice(0, 10);

                return {
                    type: "bar",
                    data: {
                        labels: sorted.map(m => m.title.length > 15 ? m.title.substring(0, 15) + "..." : m.title),
                        datasets: [{
                            label: "Vé bán ra",
                            data: sorted.map(m => m.count),
                            backgroundColor: ["#f97316", "#3b82f6", "#10b981", "#8b5cf6", "#ec4899", "#f59e0b", "#14b8a6", "#6366f1", "#a855f7", "#06b6d4"],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: "y"
                    }
                };
            }

            if (tabName === "topCombos") {
                const sorted = getComboStats().top.slice(0, 10);
                return {
                    type: "bar",
                    data: {
                        labels: sorted.map(c => c.name.length > 18 ? c.name.substring(0, 18) + "..." : c.name),
                        datasets: [{
                            label: "Combo đã bán",
                            data: sorted.map(c => c.qty),
                            backgroundColor: "#f97316",
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: "y"
                    }
                };
            }

            if (tabName === "topCinemas") {
                // Top Cinemas by bookings
                const cinemaMap = {};
                state.cinemas.forEach(c => {
                    cinemaMap[c.name] = { name: c.name, count: 0 };
                });
                getCompletedBookings().forEach(b => {
                    const name = b.cinemaName || "Khác";
                    if (!cinemaMap[name]) cinemaMap[name] = { name: name, count: 0 };
                    cinemaMap[name].count++;
                });

                const sorted = Object.values(cinemaMap)
                    .sort((a,b) => b.count - a.count)
                    .slice(0, 10);

                return {
                    type: "bar",
                    data: {
                        labels: sorted.map(c => c.name),
                        datasets: [{
                            label: "Số đơn đặt thành công",
                            data: sorted.map(c => c.count),
                            backgroundColor: "#8b5cf6",
                            borderRadius: 6
                        }]
                    }
                };
            }

            if (tabName === "payments") {
                // Payment gateways distribution
                const gateMap = { "Momo": 0, "VNPay": 0, "MB Bank": 0, "Cash": 0, "Khác": 0 };
                state.payments.forEach(p => {
                    const m = p.method || p.paymentMethod || "Khác";
                    let matched = "Khác";
                    if (normalizeValue(m).includes("momo")) matched = "Momo";
                    else if (normalizeValue(m).includes("vnpay")) matched = "VNPay";
                    else if (normalizeValue(m).includes("mb") || normalizeValue(m).includes("bank")) matched = "MB Bank";
                    else if (normalizeValue(m).includes("cash") || normalizeValue(m).includes("tiền mặt")) matched = "Cash";

                    gateMap[matched]++;
                });

                return {
                    type: "doughnut",
                    data: {
                        labels: Object.keys(gateMap),
                        datasets: [{
                            data: Object.values(gateMap),
                            backgroundColor: ["#a21caf", "#0369a1", "#047857", "#475569", "#64748b"]
                        }]
                    },
                    options: {
                        maintainAspectRatio: false
                    }
                };
            }

            if (tabName === "userGrowth") {
                // Cumulative registrations by month
                const months = [];
                for (let i = 11; i >= 0; i--) {
                    const d = new Date();
                    d.setMonth(d.getMonth() - i);
                    months.push({
                        year: d.getFullYear(),
                        month: d.getMonth(),
                        label: d.toLocaleDateString("vi-VN", { month: "short", year: "2-digit" }),
                        registrations: 0
                    });
                }
                
                state.users.forEach(u => {
                    const ud = toDateObject(u.createdAt);
                    if (!ud) return;
                    const item = months.find(m => m.month === ud.getMonth() && m.year === ud.getFullYear());
                    if (item) item.registrations++;
                });

                // Compute cumulative sum
                let sum = state.users.length;
                // Subtract months in chart to get starting sum
                const chartRegCount = months.reduce((s, m) => s + m.registrations, 0);
                let currentTotal = Math.max(0, sum - chartRegCount);
                
                const cumulativeData = months.map(m => {
                    currentTotal += m.registrations;
                    return currentTotal;
                });

                return {
                    type: "line",
                    data: {
                        labels: months.map(m => m.label),
                        datasets: [{
                            label: "Tổng người dùng (Tích lũy)",
                            data: cumulativeData,
                            borderColor: "#ec4899",
                            backgroundColor: "rgba(236, 72, 153, 0.08)",
                            fill: true,
                            tension: 0.3
                        }]
                    }
                };
            }

            return null;
        }

        function createOrUpdateChart() {
            const canvas = document.getElementById("dashboardAnalyticChart");
            if (!canvas || !window.Chart || state.isRenderingChart) return;

            const config = buildChartData(state.currentActiveChartTab);
            if (!config) return;

            state.isRenderingChart = true;
            try {
                if (state.chartInstance) {
                    state.chartInstance.destroy();
                    state.chartInstance = null;
                }

                // Get theme colors BEFORE chart construction to bake them into initial config
                const colors = window.AeroAdmin?.getThemeColors?.() || {
                    bg: "#0f172a", card: "#1e293b", border: "#334155",
                    text: "#f8fafc", muted: "#cbd5e1", primary: "#f58220"
                };

                // Standard layout rules
                const chartOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    plugins: {
                        legend: {
                            position: "top",
                            labels: {
                                boxWidth: 12,
                                font: { family: "Inter", weight: 600 },
                                color: colors.text
                            }
                        }
                    },
                    scales: config.type === "doughnut" ? {} : {
                        y: {
                            beginAtZero: true,
                            grid: { color: colors.border },
                            ticks: { color: colors.muted }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: colors.muted }
                        }
                    }
                };

                // Merge specialized options
                const mergedOptions = { ...chartOptions, ...config.options };
                if (config.options?.plugins) {
                    mergedOptions.plugins = { ...chartOptions.plugins, ...config.options.plugins };
                }
                if (config.options?.scales) {
                    mergedOptions.scales = { ...chartOptions.scales, ...config.options.scales };
                }

                // Create chart — do NOT call update() after construction,
                // Chart.js constructor already performs the initial render.
                state.chartInstance = new Chart(canvas, {
                    type: config.type,
                    data: config.data,
                    options: mergedOptions
                });
            } finally {
                state.isRenderingChart = false;
            }
        }

        function scheduleDashboardChart() {
            if (state.chartRenderTimer) clearTimeout(state.chartRenderTimer);
            state.chartRenderTimer = setTimeout(createOrUpdateChart, 150);
        }

        // Render dashboard elements
        function renderDashboard() {
            updateSummaryCards();
            renderWidgets();
            scheduleDashboardChart();
        }

        // Attach listeners to firestore collections
        function attachRealtimeListeners() {
            const db = window.AeroAdmin?.db || window.db;
            if (!db) {
                window.AeroAdmin?.toast?.("error", "Firebase chưa sẵn sàng", "Không thể khởi tạo listeners.");
                return;
            }

            // Measure response times
            const startTime = performance.now();

            state.unsubscribers.forEach(unsub => unsub());
            state.unsubscribers = [];

            let loadedCounter = 0;

            collections.forEach(collName => {
                const unsub = onSnapshot(collection(db, collName), (snap) => {
                    state[collName] = snap.docs.map(docSnap => ({
                        id: docSnap.id,
                        ...docSnap.data()
                    }));
                    state.loaded.add(collName);
                    
                    if (state.loaded.size === collections.length) {
                        if (loadedCounter === 0) {
                            const delay = Math.round(performance.now() - startTime);
                            document.getElementById("healthPing").innerText = `${delay} ms`;
                            if (delay > 500) {
                                document.getElementById("healthPulse").className = "pulse-indicator yellow";
                            } else {
                                document.getElementById("healthPulse").className = "pulse-indicator green";
                            }
                            loadedCounter++;
                        }
                    }

                    renderDashboard();
                }, (err) => {
                    console.error(`Firestore error on collection ${collName}:`, err);
                    document.getElementById("healthStatus").innerText = "Sự cố";
                    document.getElementById("healthPulse").className = "pulse-indicator yellow";
                });

                state.unsubscribers.push(unsub);
            });
        }

        // Setup chart tabs triggers
        function setupChartTabs() {
            document.querySelectorAll(".chart-tab-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.querySelectorAll(".chart-tab-btn").forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    state.currentActiveChartTab = btn.dataset.chart;
                    if (state.chartRenderTimer) clearTimeout(state.chartRenderTimer);
                    createOrUpdateChart();
                });
            });
        }

        // Handle Theme Changes — only update options + dataset colors, then call update("none") once.
        // Do NOT re-create the chart or call applyChartTheme (which is already called globally by the layout).
        window.addEventListener("aero-admin-theme-change", () => {
            if (!state.chartInstance || state.isRenderingChart) return;
            state.isRenderingChart = true;
            try {
                const colors = window.AeroAdmin?.getThemeColors?.() || { primary: "#f97316", muted: "#cbd5e1", border: "#334155", text: "#f8fafc" };

                // Update dataset colors for primary-colored charts
                if (state.chartInstance.data?.datasets?.[0]) {
                    if (state.currentActiveChartTab === "revenue30") {
                        state.chartInstance.data.datasets[0].borderColor = colors.primary;
                    } else if (state.currentActiveChartTab === "revenue12") {
                        state.chartInstance.data.datasets[0].backgroundColor = colors.primary;
                    }
                }

                // Update scale + legend colors directly on existing options
                if (state.chartInstance.options.scales?.x) {
                    state.chartInstance.options.scales.x.ticks = state.chartInstance.options.scales.x.ticks || {};
                    state.chartInstance.options.scales.x.ticks.color = colors.muted;
                    state.chartInstance.options.scales.x.grid = state.chartInstance.options.scales.x.grid || {};
                    state.chartInstance.options.scales.x.grid.color = colors.border;
                }
                if (state.chartInstance.options.scales?.y) {
                    state.chartInstance.options.scales.y.ticks = state.chartInstance.options.scales.y.ticks || {};
                    state.chartInstance.options.scales.y.ticks.color = colors.muted;
                    state.chartInstance.options.scales.y.grid = state.chartInstance.options.scales.y.grid || {};
                    state.chartInstance.options.scales.y.grid.color = colors.border;
                }
                if (state.chartInstance.options.plugins?.legend?.labels) {
                    state.chartInstance.options.plugins.legend.labels.color = colors.text;
                }

                state.chartInstance.update("none");
            } finally {
                state.isRenderingChart = false;
            }
        });

        // App ready initialization
        window.addEventListener("aero-admin-ready", () => {
            setupChartTabs();
            attachRealtimeListeners();
        }, { once: true });

        if (window.AeroAdmin?.state?.ready) {
            setupChartTabs();
            attachRealtimeListeners();
        }

        window.addEventListener("beforeunload", () => {
            state.unsubscribers.forEach(unsub => unsub());
        });
    </script>
}
