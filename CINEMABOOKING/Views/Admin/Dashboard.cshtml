@{
    ViewBag.Title = "Bảng Điều Khiển Quản Trị - AERO Cinema";
}

<style>
    :root {
        --primary-color: #005baa;
        --accent-color: #f58220;
        --accent-hover: #e07316;
        --text-main: #1f2937;
        --text-sub: #6b7280;
        --border-color: #e5e7eb;
        --bg-body: #f6f6f6;
        --bg-card: #ffffff;
        --success-color: #16a34a;
        --shadow-new: 0 8px 24px rgba(0, 0, 0, 0.08);
        --font-family: 'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    body {
        background-color: var(--bg-body) !important;
        font-family: var(--font-family) !important;
        color: var(--text-main) !important;
    }

    /* Admin Dashboard Layout Styles */
    .admin-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: calc(100vh - 72px);
        background-color: var(--bg-body);
    }

    .admin-sidebar {
        background-color: #ffffff;
        border-right: 1px solid var(--border-color);
        padding: 30px 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .admin-sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .admin-menu-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 25px;
        font-size: 14px;
        font-weight: 700;
        color: var(--text-sub);
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
        cursor: pointer;
        text-decoration: none;
    }

    .admin-menu-item:hover, .admin-menu-item.active {
        color: var(--primary-color);
        background-color: rgba(0, 91, 170, 0.04);
        border-left-color: var(--primary-color);
    }

    .admin-menu-item i {
        font-size: 16px;
        width: 20px;
        text-align: center;
    }

    .admin-sidebar-footer {
        padding: 15px 25px 0 25px;
        font-size: 11px;
        color: var(--text-sub);
        border-top: 1px solid var(--border-color);
    }

    .admin-main {
        padding: 40px;
        overflow-y: auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 20px;
    }

    .admin-title {
        font-size: 26px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--text-main);
        margin: 0;
        letter-spacing: 0.5px;
    }

    .admin-user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        padding: 8px 18px;
        border-radius: 30px;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .admin-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 14px;
    }

    .admin-username {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-main);
    }

    /* STATS CARDS */
    .admin-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .stat-card {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--shadow-new);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--primary-color);
    }

    .stat-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .stat-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-sub);
        text-transform: uppercase;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 26px;
        font-weight: 800;
        color: var(--text-main);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        background-color: rgba(0, 91, 170, 0.08);
        color: var(--primary-color);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* CHARTS & ANALYTICS */
    .dashboard-analytics-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 35px;
    }

    .analytics-card {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px;
        box-shadow: var(--shadow-new);
    }

    .analytics-card-title {
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-main);
        margin-bottom: 25px;
        border-left: 4px solid var(--primary-color);
        padding-left: 10px;
    }

    /* CSS Bar Chart */
    .bar-chart-container {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 200px;
        padding-top: 20px;
        position: relative;
        background-color: #ffffff;
    }

    .bar-chart-track {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        position: relative;
        background-color: #f9fafb;
        margin: 0 6px;
        border-radius: 4px;
    }

    .bar-chart-fill {
        width: 24px;
        border-radius: 6px 6px 0 0;
        background: linear-gradient(to top, var(--primary-color), #3b82f6);
        transition: height 1s ease-in-out;
        position: relative;
        cursor: pointer;
    }

    .bar-chart-fill:hover {
        background: var(--accent-color);
        box-shadow: 0 0 10px rgba(245, 130, 32, 0.4);
    }

    .bar-tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translate(-50%, -10px);
        background: #1f2937;
        border: 1px solid #1f2937;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
        z-index: 10;
    }

    .bar-chart-fill:hover .bar-tooltip {
        opacity: 1;
    }

    .bar-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-sub);
        margin-top: 10px;
    }

    /* TABLE SECTION */
    .admin-table-card {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px;
        box-shadow: var(--shadow-new);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .admin-table th, .admin-table td {
        padding: 16px 20px;
        font-size: 14px;
        border-bottom: 1px solid var(--border-color);
    }

    .admin-table th {
        font-weight: 700;
        color: var(--text-sub);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        background-color: #f9fafb;
    }

    .admin-table tbody tr:hover {
        background-color: #f9fafb;
    }

    /* Status badges */
    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 700;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge.completed {
        background-color: rgba(22, 163, 74, 0.1);
        color: var(--success-color);
    }

    .status-badge.pending {
        background-color: rgba(245, 158, 11, 0.1);
        color: var(--warning-color);
    }

    .btn-action-view {
        background: transparent;
        border: 1px solid var(--primary-color);
        color: var(--primary-color);
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
    }

    .btn-action-view:hover {
        background-color: var(--primary-color);
        color: #ffffff;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .admin-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-analytics-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 992px) {
        .admin-layout {
            grid-template-columns: 1fr;
        }

        .admin-sidebar {
            flex-direction: row;
            overflow-x: auto;
            padding: 10px 20px;
            border-right: none;
            border-bottom: 1px solid var(--border-color);
        }

        .admin-sidebar-menu {
            flex-direction: row;
            width: 100%;
        }

        .admin-menu-item {
            padding: 12px 20px;
            border-left: none;
            border-bottom: 4px solid transparent;
            white-space: nowrap;
        }

        .admin-menu-item:hover, .admin-menu-item.active {
            border-left-color: transparent;
            border-bottom-color: var(--primary-color);
        }

        .admin-sidebar-footer {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .admin-stats-grid {
            grid-template-columns: 1fr;
        }

        .admin-main {
            padding: 20px;
        }
    }

    /* Skeleton Loader & Shimmer Animation */
    .skeleton {
        background: linear-gradient(90deg, #eeeeee 25%, #f8f8f8 50%, #eeeeee 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite;
        border-radius: 8px;
        display: inline-block;
    }

    .bar-chart-fill.skeleton {
        background: linear-gradient(90deg, #eeeeee 25%, #f8f8f8 50%, #eeeeee 75%) !important;
        background-size: 200% 100% !important;
        animation: shimmer 1.2s infinite !important;
        pointer-events: none;
    }

    @@keyframes shimmer {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }
</style>

