@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var pageTitle = "AERO Cinema";

    if (ViewBag.Title != null)
    {
        pageTitle = ViewBag.Title.ToString();
    }

    var controllerName = "";
    var actionName = "";

    if (ViewContext != null && ViewContext.RouteData != null && ViewContext.RouteData.Values["controller"] != null)
    {
        controllerName = ViewContext.RouteData.Values["controller"].ToString();
    }

    if (ViewContext != null && ViewContext.RouteData != null && ViewContext.RouteData.Values["action"] != null)
    {
        actionName = ViewContext.RouteData.Values["action"].ToString();
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preconnect" href="https://www.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://image.tmdb.org" crossorigin>
    <link rel="dns-prefetch" href="//image.tmdb.org">
    <link rel="dns-prefetch" href="//www.gstatic.com">
    <title>@pageTitle - AERO Cinema</title>

    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/css/bootstrap.min.css" />

    <link href="@Url.Content("~/Content/responsive.css?v=1")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/chatbot.css?v=2026")" rel="stylesheet" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800;900&display=swap');

        :root {
            --primary-color: #005baa; /* AERO Blue */
            --accent-color: #f58020; /* Galaxy Orange */
            --primary-hover: #023873;
            --accent-hover: #d46813;
            --bg-body: #f6f6f6;
            --bg-card: #ffffff;
            --text-main: #333333;
            --text-sub: #777777;
            --border-color: #e0e0e0;
            --font-family: 'Raleway', sans-serif;
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
            --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
            --border-radius: 10px;
        }

        /* Base styles */
        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: var(--font-family);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: var(--text-main);
            text-decoration: none;
            transition: var(--transition);
        }

        a:hover {
            color: var(--primary-color);
        }

        /* Header redesign - Sticky and white */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            transition: var(--transition);
        }

        .header-logo a {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .header-logo span {
            color: var(--accent-color);
        }

        /* Main Menu centered */
        .header-nav {
            display: flex;
            align-items: center;
            gap: 30px;
            margin: 0 auto 0 40px;
        }

        .header-nav a {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #444;
            padding: 8px 0;
            position: relative;
        }

        .header-nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 3px;
            background-color: var(--accent-color);
            transition: var(--transition);
        }

        .header-nav a:hover {
            color: var(--primary-color);
        }

        .header-nav a:hover::after,
        .header-nav a.active::after {
            width: 100%;
        }

        .header-nav a.active {
            color: var(--primary-color);
        }

        /* Header Right Controls */
        .header-controls {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* Search input bar */
        .header-search-bar {
            position: relative;
            width: 240px;
        }

        .header-search-bar input {
            width: 100%;
            background-color: #f0f2f5;
            border: 1px solid transparent;
            border-radius: 20px;
            padding: 6px 15px 6px 35px;
            color: var(--text-main);
            font-size: 13px;
            outline: none;
            transition: var(--transition);
        }

        .header-search-bar input:focus {
            background-color: #ffffff;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(0, 91, 170, 0.15);
        }

        .header-search-bar i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-sub);
            font-size: 13px;
        }

        /* Auth buttons */
        .auth-actions {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 13px;
            font-weight: 700;
        }

        .auth-actions a {
            color: #555;
            text-transform: uppercase;
        }

        .auth-actions a:hover {
            color: var(--primary-color);
        }

        .lang-switch {
            font-size: 12px;
            font-weight: 700;
            display: flex;
            gap: 5px;
            align-items: center;
        }

        .lang-switch span {
            cursor: pointer;
        }

        .lang-switch .active {
            color: var(--accent-color);
        }

        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 20px;
            cursor: pointer;
        }

        /* Main body layout wrapper */
        .site-wrapper {
            flex: 1;
            width: 100%;
            margin: 0 auto;
        }

        /* Footer Modern white design */
        .footer-compact {
            background-color: #ffffff;
            padding: 60px 40px 30px 40px;
            border-top: 1px solid var(--border-color);
            margin-top: 50px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            max-width: 1200px;
            margin: 0 auto 40px auto;
        }

        .footer-col h4 {
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            color: var(--primary-color);
            margin-bottom: 20px;
            letter-spacing: 0.5px;
        }

        .footer-col p,
        .footer-col li {
            font-size: 13px;
            color: var(--text-sub);
            line-height: 1.8;
            margin-bottom: 10px;
        }

        .footer-col ul {
            padding: 0;
            margin: 0;
            list-style: none;
        }

        .footer-col a {
            color: var(--text-sub);
            transition: var(--transition);
        }

        .footer-col a:hover {
            color: var(--accent-color);
            padding-left: 3px;
        }

        .footer-socials {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .footer-socials a {
            width: 36px;
            height: 36px;
            background-color: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 15px;
            color: var(--primary-color);
            transition: var(--transition);
        }

        .footer-socials a:hover {
            background-color: var(--accent-color);
            color: #ffffff;
            transform: translateY(-3px);
        }

        .footer-bottom {
            max-width: 1200px;
            margin: 0 auto;
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-sub);
        }

        /* Mobile layout styling */
        @@media (max-width: 992px) {
            .site-header {
                padding: 0 20px;
            }
            .header-nav {
                display: none;
                flex-direction: column;
                position: absolute;
                top: 72px;
                left: 0;
                width: 100%;
                background-color: #ffffff;
                padding: 20px;
                gap: 15px;
                margin: 0;
                box-shadow: var(--shadow-md);
                border-bottom: 1px solid var(--border-color);
            }
            .header-nav.open {
                display: flex;
            }
            .header-nav a::after {
                display: none;
            }
            .nav-hamburger {
                display: block;
            }
            .header-controls {
                gap: 10px;
            }
            .header-search-bar {
                display: none;
            }
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            .footer-bottom {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <!-- STICKY SITE HEADER -->
    <header class="site-header">
        <div class="header-logo">
            <a href="@Url.Action("Index", "Home")">
                <span>AERO</span> Cinema
            </a>
        </div>

        <!-- MAIN HEADER NAVIGATION -->
        <nav class="header-nav" id="headerNav">
            <a id="nav-booking-link" data-translate="nav_booking" href="@Url.Action("Index", "Showtimes")" class="@(controllerName == "Showtimes" ? "active" : "")">Mua Vé</a>
            <a id="nav-movies-link" data-translate="nav_movies" href="@Url.Action("Index", "Movies")" class="@(controllerName == "Movies" ? "active" : "")">Phim</a>
            <a id="nav-promotions-link" data-translate="nav_promotions" href="@Url.Action("Promotions", "Home")" class="@(controllerName == "Home" && actionName == "Promotions" ? "active" : "")">Ưu Đãi</a>
            <a id="nav-services-link" data-translate="nav_services" href="@Url.Action("Services", "Home")" class="@(controllerName == "Home" && actionName == "Services" ? "active" : "")">Sự Kiện</a>
            <a id="nav-cinemas-link" data-translate="nav_cinemas" href="@Url.Action("Cinemas", "Home")" class="@(controllerName == "Home" && actionName == "Cinemas" ? "active" : "")">Rạp</a>
            <a id="nav-membership-link" data-translate="nav_membership" href="@Url.Action("Membership", "Home")" class="@(controllerName == "Home" && actionName == "Membership" ? "active" : "")">Thành Viên</a>
            <a id="nav-admin-link" data-translate="nav_admin" href="@Url.Action("Dashboard", "Admin")" class="@(controllerName == "Admin" ? "active" : "")" style="display: none; color: var(--accent-color);">Quản Trị</a>
        </nav>

        <!-- CONTROLS & AUTH -->
        <div class="header-controls">
            <div class="header-search-bar">
                <input type="text" id="layoutSearch" data-translate-placeholder="search_placeholder" placeholder="Tìm kiếm phim..." autocomplete="off" />
                <i class="fas fa-search"></i>
            </div>

            <div class="auth-actions" id="auth-links">
                <a href="@Url.Action("Login", "Account")" data-translate="nav_login">Đăng nhập</a>
                <span>|</span>
                <a href="@Url.Action("Register", "Account")" data-translate="nav_register">Đăng ký</a>
            </div>

            <div class="lang-switch d-none d-sm-flex">
                <span id="lang-toggle-vi" onclick="setLanguage('vi')">VI</span>
                <span style="color: #ccc;">|</span>
                <span id="lang-toggle-en" onclick="setLanguage('en')">EN</span>
            </div>

            <button type="button" class="nav-hamburger" onclick="toggleMobileMenu()" aria-label="Menu Toggle" aria-controls="headerNav" aria-expanded="false">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </header>

    <!-- MAIN BODY SECTION -->
    <main class="site-wrapper">
        @RenderBody()
    </main>

    <!-- FOOTER SECTION -->
    <footer class="footer-compact">
        <div class="footer-grid">
            <div class="footer-col">
                <h4 style="color: var(--primary-color);">AERO Cinema</h4>
                <p data-translate="footer_desc">Hệ thống rạp chiếu phim hiện đại và tiện lợi, mang đến trải nghiệm điện ảnh chuẩn quốc tế ngay tại Việt Nam.</p>
                <p><i class="fas fa-phone-alt" style="color: var(--accent-color); margin-right: 5px;"></i> <span data-translate="footer_hotline">Hotline</span>: 037 905 2767</p>
            </div>
            
            <div class="footer-col">
                <h4 data-translate="footer_support">Hỗ trợ</h4>
                <ul>
                    <li><a data-translate="footer_faq" href="@Url.Action("Support", "Home")">Hỏi đáp FAQ</a></li>
                    <li><a data-translate="footer_guide" href="@Url.Action("Support", "Home")">Hướng dẫn đặt vé trực tuyến</a></li>
                    <li><a data-translate="footer_feedback" href="@Url.Action("Support", "Home")">Liên hệ góp ý</a></li>
                </ul>
            </div>
            
            <div class="footer-col">
                <h4 data-translate="footer_policy">Chính sách</h4>
                <ul>
                    <li><a data-translate="footer_policy_member" href="@Url.Action("Policy", "Home")">Chính sách thành viên</a></li>
                    <li><a data-translate="footer_policy_terms" href="@Url.Action("Policy", "Home")">Điều khoản sử dụng</a></li>
                    <li><a data-translate="footer_policy_payment" href="@Url.Action("Policy", "Home")">Chính sách thanh toán & đổi trả</a></li>
                </ul>
            </div>
            
            <div class="footer-col">
                <h4 data-translate="footer_connect">Kết nối</h4>
                <p><i class="fas fa-map-marker-alt" style="color: var(--accent-color); margin-right: 5px;"></i> Đức Hòa, Long An</p>
                <div class="footer-socials">
                    <a href="https://www.facebook.com/Please.respond.to.my.question"><i class="fab fa-facebook-f"></i></a>
                    <a href="https://www.instagram.com/hnamm12_04n"><i class="fab fa-instagram"></i></a>
                    <a href="https://zalo.me/0379052767"><i class="fa-solid fa-comment"></i></a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div>&copy; @DateTime.Now.Year <span data-translate="footer_rights">AERO Cinema. Bảo lưu mọi quyền.</span></div>
            <div data-translate="footer_coop">Hợp tác cùng thương hiệu AERO Cinema</div>
        </div>
    </footer>

    <!-- Script assets -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/aero-localize.js"></script>

    <script>
        function toggleMobileMenu() {
            var menu = document.getElementById("headerNav");
            var button = document.querySelector(".nav-hamburger");
            if (menu) {
                menu.classList.toggle("open");
                if (button) {
                    var isOpen = menu.classList.contains("open");
                    button.setAttribute("aria-expanded", isOpen ? "true" : "false");
                }
            }
        }

        document.addEventListener("click", function (event) {
            var menu = document.getElementById("headerNav");
            var button = document.querySelector(".nav-hamburger");
            if (!menu || !button || !menu.classList.contains("open")) return;
            if (menu.contains(event.target) || button.contains(event.target)) return;
            menu.classList.remove("open");
            button.setAttribute("aria-expanded", "false");
        });

        // Connect Layout Search with Movies index search dynamic functionality
        const layoutSearch = document.getElementById("layoutSearch");
        if (layoutSearch) {
            layoutSearch.addEventListener("keypress", (e) => {
                if (e.key === 'Enter') {
                    const queryVal = e.target.value.trim();
                    if (window.location.pathname.toLowerCase().includes('/movies')) {
                        const searchInput = document.getElementById("searchInput");
                        if (searchInput) {
                            searchInput.value = queryVal;
                            searchInput.dispatchEvent(new Event('input'));
                        }
                    } else {
                        window.location.href = `/Movies?search=${encodeURIComponent(queryVal)}`;
                    }
                }
            });
        }

        // On page load check search parameter for Movies page
        if (window.location.pathname.toLowerCase().includes('/movies')) {
            const searchParam = new URLSearchParams(window.location.search).get('search');
            if (searchParam) {
                setTimeout(() => {
                    const searchInput = document.getElementById("searchInput");
                    if (searchInput) {
                        searchInput.value = searchParam;
                        searchInput.dispatchEvent(new Event('input'));
                    }
                    const laySearchInput = document.getElementById("layoutSearch");
                    if (laySearchInput) {
                        laySearchInput.value = searchParam;
                    }
                }, 300);
            }
        }
    </script>

    <!-- Firebase SDK Global Layout Listeners -->
    <script src="@Url.Content("~/Scripts/firebase-config.js")"></script>
    <script type="module" src="@Url.Content("~/Scripts/firebase-init.js")"></script>
    <script type="module" src="@Url.Content("~/Scripts/aero-chatbot.js?v=2026")"></script>
    <script type="module">
        import { onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { doc, getDoc, updateDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const auth = window.auth;
        const db = window.db;

        window.updateUserLanguageInFirestore = async (lang) => {
            const user = auth.currentUser;
            if (user) {
                try {
                    await updateDoc(doc(db, "users", user.uid), { language: lang });
                    console.log("Synchronized language to Firestore user record:", lang);
                } catch (e) {
                    console.warn("Could not synchronize user language to Firestore:", e);
                }
            }
        };

        // Global Role Guard Helpers
        window.AeroRoleGuard = {
            safeRedirect(url) {
                if (window.__aeroRedirecting) return;
                window.__aeroRedirecting = true;
                window.location.replace(url);
            },

            isAdminProfile(profile) {
                return profile
                    && String(profile.role || "").toLowerCase() === "admin"
                    && String(profile.status || "active").toLowerCase() === "active";
            },

            isBlocked(profile) {
                return String(profile?.status || "").toLowerCase() === "blocked";
            },

            getCurrentPath() {
                return window.location.pathname + window.location.search;
            },

            isAdminRoute(path) {
                return String(path || window.location.pathname).toLowerCase().startsWith("/admin");
            },

            isBookingRoute(path) {
                const p = String(path || window.location.pathname).toLowerCase();
                return p.startsWith("/booking")
                    || p.startsWith("/account/profile")
                    || p.startsWith("/account/tickethistory");
            }
        };

        // MutationObserver to dynamically disable booking actions for admin
        let adminObserver = null;

        function disableBookingForAdmin() {
            const selectors = [
                '.btn-card-buy', 
                '.btn-primary-action', 
                '.btn-checkout', 
                '.btn-checkout-submit',
                '.btn-booking',
                '.book-btn',
                '.btn-action-booking',
                'a[href*="/Booking"]',
                'a[href*="#booking-section"]'
            ];
            
            document.querySelectorAll(selectors.join(',')).forEach(el => {
                el.classList.add('admin-disabled-btn');
                el.setAttribute('disabled', 'true');
                el.style.pointerEvents = 'none';
                el.style.opacity = '0.5';
                el.removeAttribute('href');
                el.onclick = (e) => {
                    e.preventDefault();
                    return false;
                };
            });

            // Warn banner insertion
            if (!document.getElementById('admin-warning-banner')) {
                const banner = document.createElement('div');
                banner.id = 'admin-warning-banner';
                banner.style.cssText = 'background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; padding: 12px; margin: 15px 40px; border-radius: 8px; font-weight: 700; text-align: center; font-size: 14px;';
                banner.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Bạn đang đăng nhập bằng tài khoản quản trị. Vui lòng dùng tài khoản người dùng để đặt vé.';
                
                const mainWrapper = document.querySelector('.site-wrapper');
                if (mainWrapper) {
                    mainWrapper.insertBefore(banner, mainWrapper.firstChild);
                }
            }
        }

        function startAdminObserver() {
            disableBookingForAdmin();
            if (adminObserver) adminObserver.disconnect();
            adminObserver = new MutationObserver(() => {
                disableBookingForAdmin();
            });
            adminObserver.observe(document.body, { childList: true, subtree: true });
        }

        function enableBookingForUser() {
            if (adminObserver) {
                adminObserver.disconnect();
                adminObserver = null;
            }
            const banner = document.getElementById('admin-warning-banner');
            if (banner) banner.remove();
        }

        // Add style tag dynamically for admin-disabled-btn
        const style = document.createElement('style');
        style.innerHTML = `
            .admin-disabled-btn {
                pointer-events: none !important;
                cursor: not-allowed !important;
                opacity: 0.5 !important;
            }
        `;
        document.head.appendChild(style);

        // Listen to Auth State
        onAuthStateChanged(auth, async (user) => {
            const authLinks = document.getElementById("auth-links");
            const adminLink = document.getElementById("nav-admin-link");
            const navBooking = document.getElementById("nav-booking-link");
            const navMovies = document.getElementById("nav-movies-link");
            const navPromotions = document.getElementById("nav-promotions-link");
            const navServices = document.getElementById("nav-services-link");
            const navMembership = document.getElementById("nav-membership-link");

            if (user) {
                let role = sessionStorage.getItem("aero_user_role");
                let status = sessionStorage.getItem("aero_user_status");
                let fullName = sessionStorage.getItem("aero_user_name");

                // Check unified cache
                try {
                    const cachedStr = sessionStorage.getItem("aero_auth_user");
                    if (cachedStr) {
                        const cached = JSON.parse(cachedStr);
                        if (cached && cached.uid === user.uid) {
                            role = cached.role || role;
                            status = cached.status || status;
                            fullName = cached.fullName || fullName;
                            if (cached.language) {
                                localStorage.setItem("language", cached.language);
                                if (window.applyLanguage) {
                                    window.applyLanguage(cached.language);
                                }
                            }
                        }
                    }
                } catch (e) {
                    console.warn("[Layout] Error reading cached user:", e);
                }

                if (!role || !status || !fullName) {
                    try {
                        const userDoc = await getDoc(doc(db, "users", user.uid));
                        if (userDoc.exists()) {
                            const userData = userDoc.data();
                            role = String(userData.role || "").trim().toLowerCase();
                            status = String(userData.status || "active").trim().toLowerCase();
                            fullName = userData.fullName || "";

                            const userLang = userData.language || localStorage.getItem("language") || "vi";
                            localStorage.setItem("language", userLang);
                            if (window.applyLanguage) {
                                window.applyLanguage(userLang);
                            }

                            if (!userData.language) {
                                await updateDoc(doc(db, "users", user.uid), { language: userLang });
                            }

                            // Set unified cache as well as legacy cache
                            const authUser = {
                                uid: user.uid,
                                email: user.email,
                                role: role,
                                status: status,
                                fullName: fullName,
                                language: userLang,
                                cachedAt: Date.now()
                            };
                            sessionStorage.setItem("aero_auth_user", JSON.stringify(authUser));
                            sessionStorage.setItem("aero_user_role", role);
                            sessionStorage.setItem("aero_user_status", status);
                            sessionStorage.setItem("aero_user_name", fullName);
                        }
                    } catch (error) {
                        console.error("Error fetching user role: ", error);
                    }
                }

                const isAdmin = role === "admin" && status === "active";
                const isBlocked = status === "blocked";

                if (isBlocked) {
                    sessionStorage.removeItem("aero_auth_user");
                    sessionStorage.removeItem("aero_user_role");
                    sessionStorage.removeItem("aero_user_status");
                    sessionStorage.removeItem("aero_user_name");
                    await signOut(auth);
                    window.AeroRoleGuard.safeRedirect("/Account/Login");
                    return;
                }

                if (isAdmin) {
                    if (navBooking) navBooking.style.display = "none";
                    if (navMovies) navMovies.style.display = "none";
                    if (navPromotions) navPromotions.style.display = "none";
                    if (navServices) navServices.style.display = "none";
                    if (navMembership) navMembership.style.display = "none";
                    if (adminLink) adminLink.style.display = "inline-block";

                    // Prevent Admin from entering booking / details / account pages
                    const path = window.location.pathname.toLowerCase();
                    if (window.AeroRoleGuard.isBookingRoute() || path.startsWith("/movies/details")) {
                        window.AeroRoleGuard.safeRedirect("/Admin/Dashboard");
                        return;
                    }

                    // Enable background block for booking actions on public pages
                    startAdminObserver();
                } else {
                    if (navBooking) navBooking.style.display = "";
                    if (navMovies) navMovies.style.display = "";
                    if (navPromotions) navPromotions.style.display = "";
                    if (navServices) navServices.style.display = "";
                    if (navMembership) navMembership.style.display = "";
                    if (adminLink) adminLink.style.display = "none";

                    enableBookingForUser();
                }

                const displayName = fullName || user.displayName || user.email || "TÀI KHOẢN";
                const currentLang = localStorage.getItem("language") || "vi";
                const roleLabelVal = isAdmin ? "Admin" : (currentLang === "en" ? "Member" : "Thành viên");
                const logoutText = currentLang === "en" ? "Logout" : "Đăng xuất";

                if (authLinks) {
                    authLinks.innerHTML = `
                        <a href="@Url.Action("Profile", "Account")" style="color: var(--primary-color); font-weight: 700;">${displayName.toUpperCase()} · <span id="nav-role-label">${roleLabelVal}</span></a>
                        <span style="color:#ddd">|</span>
                        <a href="#" id="nav-logout-btn" data-translate="nav_logout">${logoutText}</a>
                    `;

                    const logoutBtn = document.getElementById("nav-logout-btn");
                    if (logoutBtn) {
                        logoutBtn.addEventListener("click", async (e) => {
                            e.preventDefault();
                            const isEn = localStorage.getItem("language") === "en";
                            Swal.fire({
                                title: isEn ? 'Are you sure you want to log out?' : 'Bạn có chắc chắn muốn đăng xuất?',
                                icon: 'question',
                                showCancelButton: true,
                                confirmButtonColor: 'var(--primary-color)',
                                cancelButtonColor: '#aaa',
                                confirmButtonText: isEn ? 'Logout' : 'Đăng xuất',
                                cancelButtonText: isEn ? 'Cancel' : 'Hủy',
                                background: '#ffffff',
                                color: '#333'
                            }).then(async (result) => {
                                if (result.isConfirmed) {
                                    try {
                                        enableBookingForUser();
                                        sessionStorage.removeItem("aero_auth_user");
                                        sessionStorage.removeItem("aero_user_role");
                                        sessionStorage.removeItem("aero_user_status");
                                        sessionStorage.removeItem("aero_user_name");
                                        await signOut(auth);
                                        window.location.replace("@Url.Action("Login", "Account")");
                                    } catch (error) {
                                        console.error("Error signing out: ", error);
                                    }
                                }
                            });
                        });
                    }
                }
            } else {
                enableBookingForUser();

                // If guest attempts to access booking / account profile / history routes
                const currentPath = window.AeroRoleGuard.getCurrentPath();
                if (window.AeroRoleGuard.isBookingRoute()) {
                    sessionStorage.setItem("aero_return_url", currentPath);
                    window.AeroRoleGuard.safeRedirect(`/Account/Login?returnUrl=${encodeURIComponent(currentPath)}`);
                    return;
                }

                if (navBooking) navBooking.style.display = "";
                if (navMovies) navMovies.style.display = "";
                if (navPromotions) navPromotions.style.display = "";
                if (navServices) navServices.style.display = "";
                if (navMembership) navMembership.style.display = "";
                if (adminLink) adminLink.style.display = "none";

                if (authLinks) {
                    const loginText = (localStorage.getItem("language") || "vi") === "en" ? "Login" : "Đăng nhập";
                    const regText = (localStorage.getItem("language") || "vi") === "en" ? "Register" : "Đăng ký";
                    authLinks.innerHTML = `
                        <a href="@Url.Action("Login", "Account")" data-translate="nav_login">${loginText}</a>
                        <span style="color:#ddd">|</span>
                        <a href="@Url.Action("Register", "Account")" data-translate="nav_register">${regText}</a>
                    `;
                }
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
